---
/**
 * Visor de Widgets — UI Kit / Storybook interno del Design System V2.
 * -------------------------------------------------------------------
 * Funcionalidades:
 *   1. Sidebar oscuro con índice de widgets + switcher de BU
 *      (pills con swatch real, leído desde `bu-colors.json`).
 *   2. Por cada widget:
 *      - Header con título + viewport switcher (Desktop / Tablet / Mobile)
 *      - Preview a FULL WIDTH (con `max-width` aplicado según viewport).
 *      - Drawer de "Props" a la derecha, oculto por defecto (toggle).
 *      - Live editing: cambiar inputs/textarea actualiza el preview.
 *   3. Persistencia del BU seleccionado en `localStorage`.
 *
 * Layout:
 *   sidebar (280px, slate-800)  │  main (slate-900)
 *                                │
 *                                │  ┌─ widget head ──────────────┐
 *                                │  │ Title           [D|T|M] ⚙ │
 *                                │  └────────────────────────────┘
 *                                │  ┌─ preview ──────┐ ┌─ drawer ┐
 *                                │  │  (full width)  │ │ (hidden)│
 *                                │  │                │ │         │
 *                                │  └────────────────┘ └─────────┘
 *
 * Estrategia de tema:
 *   - El switcher de BU setea `data-bu` en <html>.
 *   - Los tokens se resuelven vía CSS variables en `global.css`:
 *       [data-bu="pregrado"] { --bu-color-brand-primary: #...; }
 *   - Tailwind v4 @theme genera utilities `bg-bu-primary`, etc.
 *
 * Cómo registrar un widget nuevo:
 *   Ver `generador-landings/src/components/widgets/registry.ts` (registry central).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import {
  widgetRegistry,
  DEFAULT_CARD6_FIELDS,
  type WidgetRegistration,
  type Card6FieldSpec,
} from '../components/widgets/registry.ts';
import { ICON_PATHS } from '../components/widgets/5-save-the-date/icons.ts';
import buColors from '@data/bu-colors.json';

// Normalizamos el JSON a una lista [{id, primary, secondary, ...}].
const busList = Object.entries(buColors.bus).map(([id, palette]) => ({
  id,
  ...(palette as { primary: string; secondary: string; accent: string; surface: string; neutral: string }),
}));

// Cards de la variante default de un widget — usa el override por-variante
// si existe, si no cae al `defaults.cards` compartido (caso de widgets con
// una sola variante, como 5-save-the-date).
function defaultCardsFor(w: WidgetRegistration) {
  return w.variants.find((v) => v.id === w.defaultVariant)?.cards ?? w.defaults.cards;
}

// Mapa variantId → cards, para hidratar el estado del editor en el cliente
// cuando el usuario cambia de variante por primera vez.
function cardsByVariant(w: WidgetRegistration) {
  return Object.fromEntries(w.variants.map((v) => [v.id, v.cards ?? w.defaults.cards ?? []]));
}

// Schema de campos editables por card de una variante — cada variante puede
// tener una estructura distinta (ver `WidgetVariant.cardFields`); si no
// declara uno propio, usa el default de 3 campos (título/texto/CTA).
function cardFieldsFor(w: WidgetRegistration, variantId: string): Card6FieldSpec[] {
  return w.variants.find((v) => v.id === variantId)?.cardFields ?? DEFAULT_CARD6_FIELDS;
}

// Mapa variantId → schema de campos, para que el editor del cliente sepa
// qué inputs mostrar al cambiar de variante (sin acceso a registry.ts, que
// es server-only).
function cardFieldsByVariant(w: WidgetRegistration) {
  return Object.fromEntries(w.variants.map((v) => [v.id, v.cardFields ?? DEFAULT_CARD6_FIELDS]));
}
---

<BaseLayout
  title="Visor de Widgets"
  description="Catálogo navegable del Design System V2 con switcher de unidad de negocio y viewport responsive."
>
  <style>
    /* ============================================================
       Visor — fondo oscuro para que solo el widget "salte" al ojo
       ============================================================ */
    .visor {
      display: grid;
      grid-template-columns: 280px 1fr;
      min-height: 100vh;
      background: #0f172a;            /* slate-900 — fondo principal oscuro */
      color: #e2e8f0;                 /* slate-200 — texto base */
      font-family: 'Montserrat', system-ui, sans-serif;
    }

    /* ── SIDEBAR ──────────────────────────────────────────────── */
    .visor__sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      background: #1e293b;            /* slate-800 */
      border-right: 1px solid #334155;
      padding: 1.5rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .visor__brand h1 {
      font-size: 1.125rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin: 0;
      color: #f1f5f9;
    }
    .visor__brand p {
      font-size: 0.6875rem;
      color: #64748b;
      margin: 0.25rem 0 0;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .visor__sidebar-label {
      display: block;
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #64748b;
      margin-bottom: 0.625rem;
    }
    .visor__bus-list {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }
    .visor__bu-pill {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.8125rem;
      font-weight: 600;
      border: 1px solid #334155;
      border-radius: 0.5rem;
      background: #0f172a;
      cursor: pointer;
      transition: all 0.15s ease;
      color: #cbd5e1;
      text-align: left;
      width: 100%;
    }
    .visor__bu-pill:hover {
      border-color: #475569;
      color: #f1f5f9;
    }
    .visor__bu-pill.is-active {
      border-color: var(--bu-color-brand-primary, #3b82f6);
      background: var(--bu-color-brand-primary, #3b82f6);
      color: #ffffff;
    }
    .visor__bu-swatch {
      width: 0.875rem;
      height: 0.875rem;
      border-radius: 999px;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
      flex-shrink: 0;
    }
    .visor__nav ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
    }
    .visor__nav a {
      display: block;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      color: #cbd5e1;
      text-decoration: none;
      border-radius: 0.5rem;
      transition: all 0.15s ease;
      cursor: pointer;
    }
    .visor__nav a:hover {
      background: #334155;
      color: #f1f5f9;
    }
    .visor__nav a.is-active {
      background: var(--bu-color-brand-primary, #3b82f6);
      color: #ffffff;
    }

    /* ── MAIN ────────────────────────────────────────────────── */
    .visor__main {
      padding: 1.5rem 2rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      overflow-y: auto;
      height: 100vh;
      box-sizing: border-box;
    }

    /* ── WIDGET SECTION ──────────────────────────────────────── */
    .visor__widget-section {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 1rem;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      max-height: calc(100vh - 3rem);
    }
    .visor__widget-section.is-hidden,
    .visor__widget-section[hidden] {
      display: none;
    }
    .visor__widget-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.5rem;
      border-bottom: 1px solid #334155;
      background: rgba(15, 23, 42, 0.5);
      flex-wrap: wrap;
    }
    .visor__widget-title h2 {
      font-size: 1rem;
      font-weight: 800;
      margin: 0;
      color: #f1f5f9;
    }
    .visor__widget-title p {
      font-size: 0.8125rem;
      color: #94a3b8;
      margin: 0.25rem 0 0;
      max-width: 480px;
    }
    .visor__widget-toolbar {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    /* ── VIEWPORT SWITCHER ───────────────────────────────────── */
    .visor__viewport-switcher {
      display: inline-flex;
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 0.5rem;
      padding: 0.25rem;
      gap: 0.125rem;
    }
    .visor__viewport-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.4375rem 0.75rem;
      color: #94a3b8;
      border: none;
      border-radius: 0.375rem;
      background: transparent;
      cursor: pointer;
      transition: all 0.15s ease;
      font-size: 0.75rem;
      font-weight: 600;
      font-family: inherit;
    }
    .visor__viewport-btn:hover {
      color: #f1f5f9;
    }
    .visor__viewport-btn.is-active {
      background: #3b82f6;
      color: #ffffff;
    }
    .visor__viewport-btn svg {
      width: 0.875rem;
      height: 0.875rem;
    }

    /* ── EDIT TOGGLE ─────────────────────────────────────────── */
    .visor__edit-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.4375rem 0.875rem;
      background: #0f172a;
      color: #cbd5e1;
      border: 1px solid #334155;
      border-radius: 0.5rem;
      font-size: 0.75rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .visor__edit-toggle:hover {
      color: #f1f5f9;
      border-color: #475569;
    }
    .visor__edit-toggle.is-active {
      background: #3b82f6;
      color: #ffffff;
      border-color: #3b82f6;
    }

    /* ── WIDGET BODY (preview + drawer) ──────────────────────── */
    .visor__widget-body {
      display: grid;
      grid-template-columns: 1fr;
      transition: grid-template-columns 0.3s ease;
    }
    .visor__widget-body.has-controls {
      grid-template-columns: 1fr 340px;
    }

    /* ── PREVIEW ─────────────────────────────────────────────── */
    .visor__preview-wrap {
      padding: 1.5rem;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      min-height: 240px;
    }
    .visor__preview-frame {
      width: 100%;
      background: #ffffff;
      border-radius: 0.5rem;
      overflow-y: auto;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
      transition: max-width 0.3s ease, width 0.3s ease;
      max-height: calc(100vh - 200px);
    }
    /* Tamaños de viewport (como el switcher del visor V1) */
    .visor__preview-frame[data-viewport="desktop"] { max-width: 100%; }
    .visor__preview-frame[data-viewport="tablet"]  { max-width: 780px; }
    .visor__preview-frame[data-viewport="mobile"]  { max-width: 375px; }

    .visor__preview-instance {
      position: relative;
    }
    .visor__preview-instance[hidden] {
      display: none;
    }
    /* El iframe llena el ancho disponible (que el switcher de viewport ya
       controla vía max-width en .visor__preview-frame); la altura la fija
       el JS según el contenido real del iframe (attachAutoHeight). */
    .visor__preview-instance iframe {
      display: block;
      width: 100%;
      border: 0;
    }

    /* ── CONTROLS DRAWER ─────────────────────────────────────── */
    .visor__controls {
      background: #0f172a;
      border-left: 1px solid #334155;
      padding: 1.25rem;
      display: none;
      flex-direction: column;
      gap: 1rem;
      overflow-y: auto;
      max-height: 80vh;
    }
    .visor__widget-body.has-controls .visor__controls {
      display: flex;
    }
    .visor__control {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }
    .visor__control label {
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #64748b;
    }
    .visor__control input,
    .visor__control textarea,
    .visor__control select {
      width: 100%;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      font-family: inherit;
      border: 1px solid #334155;
      border-radius: 0.5rem;
      background: #1e293b;
      color: #e2e8f0;
      transition: all 0.15s ease;
      box-sizing: border-box;
    }
    .visor__control input:focus,
    .visor__control textarea:focus,
    .visor__control select:focus {
      outline: none;
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
    }
    .visor__control textarea {
      resize: vertical;
      min-height: 5rem;
      font-family: 'JetBrains Mono', 'Menlo', monospace;
      font-size: 0.8125rem;
    }
    .visor__controls-hint {
      font-size: 0.75rem;
      color: #64748b;
      line-height: 1.5;
      padding: 0.625rem 0.75rem;
      background: rgba(59, 130, 246, 0.08);
      border-left: 2px solid #3b82f6;
      border-radius: 0.25rem;
      margin: 0;
    }
    .visor__control-hint-inline {
      display: block;
      font-weight: 400;
      font-size: 0.625rem;
      color: #64748b;
      text-transform: none;
      letter-spacing: 0;
      margin-top: 0.125rem;
    }

    /* ── Cards editor ────────────────────────────────────────── */
    .visor__cards-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .visor__card-row {
      /* Cantidad de campos variable según el schema de la variante (ver
         `cardFieldsFor` en el frontmatter) — auto-fit acomoda tanto la fila
         de 3 campos default como la de 5 campos de v6.3, sin reglas por kind. */
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr)) auto;
      gap: 0.375rem;
      align-items: center;
    }
    .visor__card-row select,
    .visor__card-row input {
      padding: 0.4375rem 0.5rem;
      font-size: 0.8125rem;
      border: 1px solid #334155;
      border-radius: 0.375rem;
      background: #1e293b;
      color: #e2e8f0;
    }
    .visor__card-icon {
      min-width: 5.5rem;
    }
    .visor__card-remove {
      width: 1.75rem;
      height: 1.75rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #334155;
      border-radius: 0.375rem;
      background: #1e293b;
      color: #f87171;
      cursor: pointer;
      font-size: 0.875rem;
      line-height: 1;
    }
    .visor__card-remove:hover {
      background: #7f1d1d;
      color: #ffffff;
      border-color: #7f1d1d;
    }
    .visor__card-add {
      margin-top: 0.5rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.75rem;
      font-weight: 600;
      border: 1px dashed #475569;
      border-radius: 0.5rem;
      background: transparent;
      color: #94a3b8;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .visor__card-add:hover {
      border-color: #3b82f6;
      color: #3b82f6;
      background: rgba(59, 130, 246, 0.05);
    }

    /* ── Mode switcher (light/dark) ───────────────────────────── */
    .visor__mode-switcher {
      display: inline-flex;
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 0.5rem;
      padding: 0.25rem;
      gap: 0.125rem;
      width: 100%;
    }
    .visor__mode-btn {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      padding: 0.4375rem 0.75rem;
      color: #94a3b8;
      border: none;
      border-radius: 0.375rem;
      background: transparent;
      cursor: pointer;
      transition: all 0.15s ease;
      font-size: 0.75rem;
      font-weight: 600;
      font-family: inherit;
    }
    .visor__mode-btn:hover {
      color: #f1f5f9;
    }
    .visor__mode-btn.is-active {
      background: var(--bu-color-brand-primary, #3b82f6);
      color: var(--bu-color-neutral, #ffffff);
    }

    /* ── RESPONSIVE ──────────────────────────────────────────── */
    @media (max-width: 1024px) {
      .visor {
        grid-template-columns: 1fr;
      }
      .visor__sidebar {
        position: relative;
        height: auto;
      }
      .visor__widget-body.has-controls {
        grid-template-columns: 1fr;
      }
      .visor__widget-body.has-controls .visor__controls {
        border-left: none;
        border-top: 1px solid #334155;
      }
    }
  </style>

  <div class="visor">

    {/* ── SIDEBAR ─────────────────────────────────────────────── */}
    <aside class="visor__sidebar">
      <header class="visor__brand">
        <h1>Visor V2</h1>
        <p>Design System · UI Kit</p>
      </header>

      <section>
        <label class="visor__sidebar-label">Unidad de Negocio</label>
        <div class="visor__bus-list" role="radiogroup" aria-label="Cambiar unidad de negocio">
          {busList.map((bu, i) => (
            <button
              type="button"
              class="visor__bu-pill"
              data-bu-target={bu.id}
              role="radio"
              aria-checked={i === 0 ? 'true' : 'false'}
            >
              <span class="visor__bu-swatch" style={`background:${bu.primary}; ${bu.primary.startsWith('#______') ? 'background: linear-gradient(135deg, #cbd5e1 50%, #475569 50%);' : ''}`}></span>
              <span>{bu.id}</span>
            </button>
          ))}
        </div>
      </section>

      <nav class="visor__nav">
        <label class="visor__sidebar-label">Widgets</label>
        <ul>
          {widgetRegistry.map((w, i) => (
            <li>
              <a
                href={`#${w.id}`}
                data-widget-nav={w.id}
                class:list={[i === 0 && 'is-active']}
                aria-current={i === 0 ? 'true' : undefined}
              >{w.name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    {/* ── MAIN ────────────────────────────────────────────────── */}
    <main class="visor__main">
      {widgetRegistry.map((w, i) => (
        <section
          id={`widget-${w.id}`}
          data-widget-panel={w.id}
          class:list={['visor__widget-section', i !== 0 && 'is-hidden']}
          hidden={i !== 0}
        >
          <header class="visor__widget-head">
            <div class="visor__widget-title">
              <h2>{w.name}</h2>
              <p>{w.description}</p>
            </div>
            <div class="visor__widget-toolbar">
              {/* Viewport switcher — Desktop/Tablet/Mobile */}
              <div class="visor__viewport-switcher" role="radiogroup" aria-label="Tamaño de viewport">
                <button
                  type="button"
                  class="visor__viewport-btn is-active"
                  data-viewport-target={w.id}
                  data-viewport="desktop"
                  aria-label="Desktop (ancho completo)"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="3" width="20" height="14" rx="2"/>
                    <path d="M8 21h8M12 17v4"/>
                  </svg>
                  Desktop
                </button>
                <button
                  type="button"
                  class="visor__viewport-btn"
                  data-viewport-target={w.id}
                  data-viewport="tablet"
                  aria-label="Tablet (780px)"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="4" y="2" width="16" height="20" rx="2"/>
                    <path d="M11 18h2"/>
                  </svg>
                  Tablet
                </button>
                <button
                  type="button"
                  class="visor__viewport-btn"
                  data-viewport-target={w.id}
                  data-viewport="mobile"
                  aria-label="Mobile (375px)"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="6" y="2" width="12" height="20" rx="2"/>
                    <path d="M11 18h2"/>
                  </svg>
                  Mobile
                </button>
              </div>

              {/* Toggle del drawer de props */}
              <button
                type="button"
                class="visor__edit-toggle"
                data-edit-toggle={w.id}
                aria-pressed="false"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
                Props
              </button>
            </div>
          </header>

          {/* Defaults de cards por variante (si el widget las usa), para que
              el editor del cliente pueda sembrar el estado de una variante
              la primera vez que se visita — sin esto no habría forma de
              conocer, en el navegador, cuántas/cuáles cards le tocan a cada
              variante que todavía no se renderizó en el editor. */}
          {w.variants.some((v) => v.cards) && (
            <script is:inline type="application/json" data-cards-defaults={w.id} set:html={JSON.stringify(cardsByVariant(w))} />
          )}

          {/* Schema de campos por variante (título/texto/CTA por default,
              o el custom que declare la variante — ver v6.3). Le dice al
              editor del cliente qué inputs reconstruir al cambiar de
              variante. */}
          {w.variants.some((v) => v.cards) && (
            <script is:inline type="application/json" data-cards-fields={w.id} set:html={JSON.stringify(cardFieldsByVariant(w))} />
          )}

          <div class="visor__widget-body" data-widget-body={w.id}>
            {/* Preview — todas las variantes pre-renderizadas; JS muestra/oculta */}
            <div class="visor__preview-wrap">
              <div class="visor__preview-frame" data-preview-frame={w.id} data-viewport="desktop">
                <div data-preview-root={w.id}>
{w.variants.flatMap((v) =>
                    (['light', 'dark'] as const).map((mode) => {
                      // Por defecto solo se muestra la combinación variant × mode por defecto.
                      // Las demás quedan en el DOM (con [hidden]) para que el cambio de
                      // variante o modo sea instantáneo sin re-render del servidor.
                      // El JS muestra/oculta cambiando este atributo según la selección.
                      const isDefaultVariant = v.id === w.defaultVariant;
                      const isDefaultMode = mode === (w.defaults.mode ?? 'light');
                      const isVisible = isDefaultVariant && isDefaultMode;

                      // Cada instancia vive en su propio <iframe>, cargando una
                      // página aislada (`widget-preview/[widget]/[variant]/[mode]`)
                      // en vez de renderizarse inline en el documento del Visor.
                      // Esto es INTENCIONAL: los breakpoints `md:`/`lg:` de Tailwind
                      // evalúan el viewport real del documento — dentro de un
                      // <iframe> ese viewport es el ancho real del iframe, así que
                      // el switcher Desktop/Tablet/Mobile del Visor (que solo cambia
                      // el max-width del contenedor) reproduce el breakpoint real
                      // en vez de mostrar el layout desktop comprimido en una caja
                      // angosta. El JS (abajo) sincroniza data-bu, título/desc/cards
                      // y altura hacia adentro del iframe vía contentDocument
                      // (mismo origen, sin necesidad de postMessage).
                      return (
                        <div
                          class="visor__preview-instance"
                          data-preview-instance={w.id}
                          data-preview-variant={v.id}
                          data-preview-mode={mode}
                          hidden={!isVisible}
                        >
                          <iframe
                            src={`/widget-preview/${w.id}/${v.id}/${mode}`}
                            title={`${w.name} — ${v.label} (${mode})`}
                          />
                        </div>
                      );
                    })
                  )}
                </div>
              </div>
            </div>

            {/* Drawer de props */}
            <aside class="visor__controls">
              <div class="visor__control">
                <label for={`variant-${w.id}`}>Variante</label>
                <select id={`variant-${w.id}`} data-control="variant" data-widget={w.id}>
                  {w.variants.map((v) => (
                    <option value={v.id} selected={v.id === w.defaultVariant}>
                      {v.label}
                    </option>
                  ))}
                </select>
              </div>

              <div class="visor__control">
                <label>Modo</label>
                <div class="visor__mode-switcher" role="radiogroup" aria-label="Modo del widget">
                  <button
                    type="button"
                    class:list={['visor__mode-btn', (w.defaults.mode ?? 'light') === 'light' && 'is-active']}
                    data-mode-set={w.id}
                    data-mode-value="light"
                    role="radio"
                    aria-checked={(w.defaults.mode ?? 'light') === 'light' ? 'true' : 'false'}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="5"/>
                      <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                      <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                    </svg>
                    Claro
                  </button>
                  <button
                    type="button"
                    class:list={['visor__mode-btn', (w.defaults.mode ?? 'light') === 'dark' && 'is-active']}
                    data-mode-set={w.id}
                    data-mode-value="dark"
                    role="radio"
                    aria-checked={(w.defaults.mode ?? 'light') === 'dark' ? 'true' : 'false'}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                    Oscuro
                  </button>
                </div>
              </div>

              <div class="visor__control">
                <label for={`title-${w.id}`}>Título</label>
                <input
                  id={`title-${w.id}`}
                  type="text"
                  data-control="title"
                  data-widget={w.id}
                  value={w.defaults.title}
                />
              </div>

              <div class="visor__control">
                <label for={`desc-${w.id}`}>{w.defaults.cards ? 'Bajada (HTML permitido)' : 'Descripción (HTML permitido)'}</label>
                <textarea
                  id={`desc-${w.id}`}
                  data-control="description"
                  data-widget={w.id}
                  rows="5"
                  set:text={w.defaults.description}
                />
              </div>

              {/* Título de soporte (caja resaltada) */}
              {w.defaults.titleSupport !== undefined && (
                <div class="visor__control">
                  <label for={`titlesupport-${w.id}`}>Título de soporte (caja resaltada)</label>
                  <input
                    id={`titlesupport-${w.id}`}
                    type="text"
                    data-control="titleSupport"
                    data-widget={w.id}
                    value={w.defaults.titleSupport}
                  />
                </div>
              )}

              {/* Editor de cards (solo si el widget las expone). Arranca con
                  las cards de la variante DEFAULT — cada variante tiene su
                  propia cantidad/contenido, no se comparte entre variantes. */}
              {defaultCardsFor(w) && (
                <div class="visor__control">
                  <label>
                    Cards
                    <span class="visor__control-hint-inline">
                      {w.id === '5-save-the-date'
                        ? '(vacías no se renderizan — comportamiento ACF)'
                        : '(estructura unificada: title, text, ctaText, image, icon, categoria, precio, periodo)'}
                    </span>
                  </label>
                  <div
                    class="visor__cards-list"
                    data-cards-editor={w.id}
                    data-cards-kind={w.id === '6-cards-items' ? 'cards6' : 'std'}
                  >
                    {defaultCardsFor(w)!.map((card: any, i: number) => {
                      if (w.id === '6-cards-items') {
                        // Campos dirigidos por schema — cada variante puede
                        // declarar los suyos (ver `cardFieldsFor`); v6.3 por
                        // ejemplo agrega Imagen y CTA URL además del default.
                        const fields = cardFieldsFor(w, w.defaultVariant);
                        return (
                          <div class="visor__card-row" data-card-row={i}>
                            {fields.map((field) => (
                              <input
                                type="text"
                                placeholder={field.label}
                                value={card[field.key] ?? ''}
                                data-field-key={field.key}
                                aria-label={field.label}
                              />
                            ))}
                            <button
                              type="button"
                              class="visor__card-remove"
                              data-card-remove={i}
                              aria-label="Eliminar card"
                            >✕</button>
                          </div>
                        );
                      }
                      return (
                        <div class="visor__card-row" data-card-row={i}>
                          <select
                            class="visor__card-icon"
                            data-card-field={`iconSlug-${w.id}-${i}`}
                            aria-label="Icono"
                          >
                            <option value="fecha" selected={card.iconSlug === 'fecha'}>📅 Fecha</option>
                            <option value="hora" selected={card.iconSlug === 'hora'}>🕐 Hora</option>
                            <option value="presencial" selected={card.iconSlug === 'presencial'}>👥 Presencial</option>
                            <option value="virtual" selected={card.iconSlug === 'virtual'}>📶 Virtual</option>
                            <option value="hibrida" selected={card.iconSlug === 'hibrida'}>💻 Híbrida</option>
                          </select>
                          <input
                            type="text"
                            placeholder="Etiqueta (ej. Fecha:)"
                            value={card.label}
                            data-card-field={`label-${w.id}-${i}`}
                            aria-label="Etiqueta"
                          />
                          <input
                            type="text"
                            placeholder="Valor (ej. 25 y 26 abril)"
                            value={card.value}
                            data-card-field={`value-${w.id}-${i}`}
                            aria-label="Valor"
                          />
                          <button
                            type="button"
                            class="visor__card-remove"
                            data-card-remove={i}
                            aria-label="Eliminar card"
                          >✕</button>
                        </div>
                      );
                    })}
                  </div>
                  <button
                    type="button"
                    class="visor__card-add"
                    data-card-add={w.id}
                    data-card-template={w.id === '6-cards-items' ? 'cards6' : 'std'}
                  >
                    + Agregar card
                  </button>
                </div>
              )}

              <p class="visor__controls-hint">
                💡 Estos campos mapean 1:1 con los Custom Fields de WordPress (ACF).
                Al editar, el preview se actualiza en vivo.
              </p>
            </aside>
          </div>
        </section>
      ))}
    </main>
  </div>

  {/* ============================================================
      Lógica cliente — bundle inline (~4KB, sin deps)
      ============================================================ */}
  <script is:inline define:vars={{ ICON_PATHS }}>
    /* Script inline — Astro lo trata como is:inline por usar define:vars.
       Mantenido como JS plano (sin tipos TS) para que Astro no lo parsee. */

    const STORAGE_BU = 'visor:bu';
    const root = document.documentElement;

    // ── Helpers de iframe ────────────────────────────────────────
    // Cada preview vive en su propio <iframe> (ver comentario en el markup
    // de arriba). Como son mismo origen, accedemos a su documento directo
    // vía contentDocument — sin postMessage.
    function getInstDoc(inst) {
      return inst?.querySelector('iframe')?.contentDocument ?? null;
    }

    // Mantiene la altura del iframe sincronizada con su contenido real
    // (varía por variante, modo, viewport y ediciones en vivo).
    function attachAutoHeight(iframe) {
      const doc = iframe.contentDocument;
      if (!doc || !doc.documentElement) return;
      const resize = () => {
        iframe.style.height = `${doc.documentElement.scrollHeight}px`;
      };
      resize();
      const ro = new ResizeObserver(resize);
      ro.observe(doc.documentElement);
    }

    // ── 1. Switcher de Unidad de Negocio ────────────────────────
    function applyBu(bu) {
      root.setAttribute('data-bu', bu);
      document
        .querySelectorAll('[data-bu-target]')
        .forEach((btn) => {
          const isActive = btn.dataset.buTarget === bu;
          btn.setAttribute('aria-checked', String(isActive));
          btn.classList.toggle('is-active', isActive);
        });
      // Propagar al <html> de cada iframe ya cargado (no cascada solo
      // porque están en documentos separados).
      document.querySelectorAll('[data-preview-instance] iframe').forEach((iframe) => {
        if (iframe.contentDocument?.documentElement) {
          iframe.contentDocument.documentElement.setAttribute('data-bu', bu);
        }
      });
    }

    const savedBu = localStorage.getItem(STORAGE_BU) ?? 'pregrado';
    applyBu(savedBu);

    // Cuando cada iframe termina de cargar: aplicar el BU actual, activar
    // el auto-height, y (para 6-cards-items) capturar su template de card.
    document.querySelectorAll('[data-preview-instance] iframe').forEach((iframe) => {
      iframe.addEventListener('load', () => {
        if (iframe.contentDocument?.documentElement) {
          iframe.contentDocument.documentElement.setAttribute(
            'data-bu',
            root.getAttribute('data-bu') ?? savedBu
          );
        }
        attachAutoHeight(iframe);
        const inst = iframe.closest('[data-preview-instance]');
        if (inst?.dataset.previewInstance === '6-cards-items') {
          captureCard6TemplateFor(inst);
        }
      });
    });

    document
      .querySelectorAll('[data-bu-target]')
      .forEach((btn) => {
        btn.addEventListener('click', () => {
          const bu = btn.dataset.buTarget;
          if (!bu) return;
          applyBu(bu);
          localStorage.setItem(STORAGE_BU, bu);
        });
      });

    // ── 2. Viewport switcher (Desktop / Tablet / Mobile) ────────
    document
      .querySelectorAll('[data-viewport-target]')
      .forEach((btn) => {
        btn.addEventListener('click', () => {
          const widgetId = btn.dataset.viewportTarget;
          const viewport = btn.dataset.viewport;
          if (!widgetId || !viewport) return;

          const frame = document.querySelector(`[data-preview-frame="${widgetId}"]`);
          if (frame) frame.setAttribute('data-viewport', viewport);

          // Marcar botón activo dentro del mismo switcher
          btn.parentElement
            ?.querySelectorAll('[data-viewport-target]')
            .forEach((b) => b.classList.toggle('is-active', b === btn));
        });
      });

    // ── 3. Edit Props toggle (abre/cierra el drawer) ────────────
    document
      .querySelectorAll('[data-edit-toggle]')
      .forEach((btn) => {
        btn.addEventListener('click', () => {
          const widgetId = btn.dataset.editToggle;
          if (!widgetId) return;
          const body = document.querySelector(`[data-widget-body="${widgetId}"]`);
          if (!body) return;
          const isOpen = body.classList.toggle('has-controls');
          btn.classList.toggle('is-active', isOpen);
          btn.setAttribute('aria-pressed', String(isOpen));
        });
      });

    // ── 4. Live prop editing ────────────────────────────────────

    // Iconos Font Awesome Free (paths completos) — inyectados desde
    // `widgets/5-save-the-date/icons.ts` vía <script define:vars>.
    // Si querés cambiar un icono, editá solo ese archivo.
    const ICONS_SVG = ICON_PATHS;

    // ── CardsItems (6) — templates de card por variante × modo ─
    // Selector explícito por variante (cada card wrapper tiene su propia
    // clase `hk-card-6-N`, ver CardsItems.astro).
    const CARD6_SELECTOR =
      '.hk-card-6-3, .hk-card-6-6, .hk-card-6-8, .hk-card-6-10, .hk-card-6-11, .hk-card-6-12';

    // Guarda un clon "pristino" del primer card renderizado por el servidor,
    // por cada combinación variant×mode, para poder clonar cards nuevas aunque
    // el usuario haya borrado todas las originales del DOM.
    // Se captura por-instancia (no de una sola pasada) porque cada iframe
    // carga de forma asíncrona e independiente — ver el listener 'load' más
    // arriba, que llama a esta función apenas ese iframe puntual terminó.
    const card6Templates = new Map();

    function captureCard6TemplateFor(inst) {
      const variant = inst.dataset.previewVariant;
      const mode = inst.dataset.previewMode;
      const doc = getInstDoc(inst);
      const variantContent = doc?.querySelector(`[data-variant-content="${variant}"]`);
      const firstCard = variantContent?.querySelector(CARD6_SELECTOR);
      if (firstCard) {
        card6Templates.set(`${variant}|${mode}`, firstCard.cloneNode(true));
      }
    }

    // ── Estado de cards "cards6" por widget × variante ──────────
    // Cada variante tiene su propia cantidad/contenido de cards, totalmente
    // independiente de las demás (no se comparten props entre variantes).
    // El editor del drawer SIEMPRE refleja la variante activa; cuando el
    // usuario cambia de variante, el estado de la anterior se guarda acá y
    // el de la nueva se restaura (o se siembra desde los defaults del
    // servidor si es la primera vez que se visita esa variante).
    const card6StateByVariant = new Map(); // key: `${widgetId}|${variant}` -> cards[]
    const card6DefaultsCache = new Map(); // key: widgetId -> {variant: cards[]}

    function readCard6Defaults(widgetId) {
      if (card6DefaultsCache.has(widgetId)) return card6DefaultsCache.get(widgetId);
      const script = document.querySelector(`script[data-cards-defaults="${widgetId}"]`);
      let parsed = {};
      if (script) {
        try {
          parsed = JSON.parse(script.textContent || '{}');
        } catch {
          parsed = {};
        }
      }
      card6DefaultsCache.set(widgetId, parsed);
      return parsed;
    }

    function getOrSeedCard6State(widgetId, variant) {
      const key = `${widgetId}|${variant}`;
      if (!card6StateByVariant.has(key)) {
        const seed = readCard6Defaults(widgetId)[variant] ?? [];
        card6StateByVariant.set(key, seed.map((c) => ({ ...c })));
      }
      return card6StateByVariant.get(key);
    }

    // ── Schema de campos por variante ───────────────────────────
    // Cada variante puede declarar su propia lista de campos editables por
    // card (ver `Card6FieldSpec`/`cardFields` en registry.ts — v6.3 agrega
    // Imagen y CTA URL). Sin schema propio, cae al default de 3 campos.
    const DEFAULT_FIELDS = [
      { key: 'title', label: 'Título' },
      { key: 'text', label: 'Texto' },
      { key: 'ctaText', label: 'CTA' },
    ];
    const card6FieldsCache = new Map(); // key: widgetId -> {variant: fieldSpec[]}

    function readCard6Fields(widgetId) {
      if (card6FieldsCache.has(widgetId)) return card6FieldsCache.get(widgetId);
      const script = document.querySelector(`script[data-cards-fields="${widgetId}"]`);
      let parsed = {};
      if (script) {
        try {
          parsed = JSON.parse(script.textContent || '{}');
        } catch {
          parsed = {};
        }
      }
      card6FieldsCache.set(widgetId, parsed);
      return parsed;
    }

    function getCard6Fields(widgetId, variant) {
      return readCard6Fields(widgetId)[variant] ?? DEFAULT_FIELDS;
    }

    // Lee las filas del editor (DOM) tal como están ahora mismo — genérico
    // sobre cualquier schema de campos (matchea por [data-field-key], no
    // por título del label, así funciona igual para 3 o 5+ campos).
    function snapshotCard6Rows(editor) {
      const rows = editor.querySelectorAll('[data-card-row]');
      return Array.from(rows).map((row) => {
        const card = {};
        row.querySelectorAll('[data-field-key]').forEach((input) => {
          card[input.dataset.fieldKey] = input.value ?? '';
        });
        return card;
      });
    }

    // Reconstruye las filas del editor a partir de un array de cards y el
    // schema de campos de la variante activa (usado al cambiar de variante
    // o al agregar una card nueva).
    function renderCard6Rows(editor, cards, fields) {
      editor.innerHTML = '';
      cards.forEach((c, i) => {
        const row = document.createElement('div');
        row.className = 'visor__card-row';
        row.setAttribute('data-card-row', String(i));

        fields.forEach((field) => {
          const input = document.createElement('input');
          input.type = 'text';
          input.placeholder = field.label;
          input.setAttribute('aria-label', field.label);
          input.setAttribute('data-field-key', field.key);
          input.value = c[field.key] ?? '';
          row.appendChild(input);
        });

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'visor__card-remove';
        removeBtn.setAttribute('data-card-remove', String(i));
        removeBtn.setAttribute('aria-label', 'Eliminar card');
        removeBtn.textContent = '✕';
        row.appendChild(removeBtn);

        editor.appendChild(row);
      });
    }

    function getCards(widgetId) {
      // Lee el estado actual del editor de cards desde el DOM.
      const editor = document.querySelector(`[data-cards-editor="${widgetId}"]`);
      if (!editor) return [];
      const kind = editor.dataset.cardsKind ?? 'std';
      if (kind === 'cards6') return snapshotCard6Rows(editor);
      const rows = editor.querySelectorAll('[data-card-row]');
      return Array.from(rows).map((row) => {
        const icon = row.querySelector('.visor__card-icon')?.value ?? 'fecha';
        const label = row.querySelector('input[aria-label="Etiqueta"]')?.value ?? '';
        const value = row.querySelector('input[aria-label="Valor"]')?.value ?? '';
        return { iconSlug: icon, label, value };
      });
    }

    function renderCards(widgetId) {
      const editor = document.querySelector(`[data-cards-editor="${widgetId}"]`);
      const kind = editor?.dataset.cardsKind ?? 'std';

      // 'cards6': el editor siempre refleja la variante actualmente visible.
      // Antes de renderizar nada, guardamos ese estado en vivo para esa
      // variante puntual (las demás variantes mantienen el suyo, sin tocarse).
      if (kind === 'cards6' && editor) {
        const activeVariant = document
          .querySelector(`[data-preview-instance="${widgetId}"]:not([hidden])`)
          ?.dataset.previewVariant;
        if (activeVariant) {
          card6StateByVariant.set(`${widgetId}|${activeVariant}`, snapshotCard6Rows(editor));
        }
      }

      const stdCards = kind === 'std' ? getCards(widgetId) : null;

      const instances = document.querySelectorAll(`[data-preview-instance="${widgetId}"]`);
      instances.forEach((inst) => {
        const doc = getInstDoc(inst);
        if (!doc) return; // el iframe todavía no cargó — se sincroniza en su 'load'

        // ── Save the Date ─────────────────────────────────
        if (kind === 'std') {
          const container = doc.querySelector('.hk-std-cards-container');
          if (!container) return;
          const valid = stdCards.filter((c) => c.label?.trim() && c.value?.trim()).slice(0, 6);
          container.innerHTML = valid
            .map((c) => {
              const path = ICONS_SVG[c.iconSlug] ?? ICONS_SVG.fecha;
              const iconSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true" class="hk-card-icon"><path d="${path}"/></svg>`;
              return `
                <div class="hk-std-card px-8 py-6 bg-bu-accent text-bu-surface rounded-lg flex items-center justify-center gap-4 lg:w-[300px] lg:min-w-[300px] md:w-[300px] md:min-w-[300px] w-[280px] min-w-[280px] flex-none" data-card-icon="${c.iconSlug}">
                  <div class="flex justify-center items-center shrink-0">${iconSvg}</div>
                  <div class="box-contenido w-[120px] md:w-fit text-left">
                    <h3 class="hk-card-label font-montserrat text-mont-card-content-mobile md:text-mont-card-content font-normal">${c.label}</h3>
                    <p class="hk-card-value font-montserrat text-mont-card-title-mobile md:text-mont-card-title font-extrabold">${c.value}</p>
                  </div>
                </div>
              `;
            })
            .join('');
          return;
        }

        // ── CardsItems (6) — busca cards DENTRO del data-variant-content activo ──
        // Cada instance tiene varios [data-variant-content=v6.X] (uno por variante).
        // Solo la activa matchea `inst.dataset.previewVariant`.
        const variant = inst.dataset.previewVariant;
        const mode = inst.dataset.previewMode;
        // Cards propias de ESTA variante — independientes de las demás.
        const cards = getOrSeedCard6State(widgetId, variant);
        const variantContent = doc.querySelector(`[data-variant-content="${variant}"]`);
        if (!variantContent) return;

        let cardEls = Array.from(variantContent.querySelectorAll(CARD6_SELECTOR));
        const container = cardEls[0]?.parentElement;
        const template = card6Templates.get(`${variant}|${mode}`);

        // Sincronizar cantidad de nodos DOM con la cantidad de cards de ESTA
        // variante: clonar el template por cada card nueva, eliminar sobrantes.
        if (container && template) {
          while (cardEls.length < cards.length) {
            const clone = template.cloneNode(true);
            container.appendChild(clone);
            cardEls.push(clone);
          }
          while (cardEls.length > cards.length) {
            cardEls.pop()?.remove();
          }
        }

        cardEls.forEach((cardEl, i) => {
          const c = cards[i];
          if (!c) return;
          const titleEl = cardEl.querySelector('.hk-card-title');
          const textEl = cardEl.querySelector('.hk-card-text');
          if (titleEl && c.title !== undefined) titleEl.textContent = c.title;
          if (textEl && c.text !== undefined) textEl.textContent = c.text;
          const ctaEl = cardEl.querySelector('.hk-card-cta');
          if (ctaEl && c.ctaText !== undefined) {
            // Reemplazar texto del CTA preservando el SVG arrow al final.
            // Estrategia: eliminar todos los text nodes, dejar el último SVG.
            const svg = ctaEl.querySelector('svg');
            ctaEl.innerHTML = '';
            // Reconstruir como wrapper span para que el texto herede font-family/weight del CSS.
            const textSpan = doc.createElement('span');
            textSpan.textContent = c.ctaText || '';
            ctaEl.appendChild(textSpan);
            if (svg) ctaEl.appendChild(svg);
            // Si no hay CTA, ocultar el <a>
            if (!c.ctaText) ctaEl.style.display = 'none';
            else ctaEl.style.display = '';
            // Link del CTA (interno o externo) — solo lo tocan las
            // variantes cuyo schema declara `ctaHref` (hoy, v6.3).
            if (c.ctaHref !== undefined) ctaEl.setAttribute('href', c.ctaHref || '#');
          }
          // Imagen opcional del card (solo v6.3 hoy — ver `cardFields` en
          // registry.ts). Sin valor, se oculta y el título ocupa el ancho
          // completo (sin caer a ningún placeholder).
          if (c.icon !== undefined) {
            const imgEl = cardEl.querySelector('.hk-card-imagen');
            if (imgEl) {
              imgEl.hidden = !c.icon;
              if (c.icon) imgEl.src = c.icon;
            }
            if (titleEl) titleEl.classList.toggle('w-full', !c.icon);
          }
        });

        // El script propio del widget (Swiper, anchos dinámicos) vive DENTRO
        // del iframe y escucha este evento en SU documento — hay que
        // dispararlo ahí, no en el documento del Visor.
        doc.dispatchEvent(
          new CustomEvent('visor:cards-changed', { detail: { widgetId } })
        );
      });
    }

    document
      .querySelectorAll('[data-control]')
      .forEach((ctrl) => {
        const widgetId = ctrl.dataset.widget;
        const control = ctrl.dataset.control;
        if (!widgetId || !control) return;

        const apply = () => {
          const instances = document.querySelectorAll(
            `[data-preview-instance="${widgetId}"]`
          );
          if (!instances.length) return;

          if (control === 'variant') {
            const newVariant = ctrl.value;
            const visibleInst = document.querySelector(
              `[data-preview-instance="${widgetId}"]:not([hidden])`
            );
            const oldVariant = visibleInst?.dataset.previewVariant;
            // Detectar el modo actual (de la instancia visible).
            const currentMode = visibleInst?.dataset.previewMode ?? 'light';

            // Cards (widgets tipo 'cards6'): cada variante tiene su propio
            // estado independiente. Al cambiar, guardamos el de la variante
            // que se abandona y cargamos el de la nueva en el editor.
            const cardsEditor = document.querySelector(
              `[data-cards-editor="${widgetId}"][data-cards-kind="cards6"]`
            );
            if (cardsEditor && oldVariant && oldVariant !== newVariant) {
              card6StateByVariant.set(
                `${widgetId}|${oldVariant}`,
                snapshotCard6Rows(cardsEditor)
              );
              const nextCards = getOrSeedCard6State(widgetId, newVariant);
              // El schema de campos (cantidad/orden de inputs por card)
              // también es propio de cada variante — se reconstruye la
              // fila entera, no solo los valores.
              renderCard6Rows(cardsEditor, nextCards, getCard6Fields(widgetId, newVariant));
            }

            instances.forEach((inst) => {
              const match =
                inst.dataset.previewVariant === newVariant &&
                inst.dataset.previewMode === currentMode;
              inst.hidden = !match;
            });
            // Sincroniza el preview con el estado recién cargado del editor
            // y dispara 'visor:cards-changed' dentro del iframe recién
            // mostrado (para que re-aplique layouts/Swiper si corresponde).
            renderCards(widgetId);
            return;
          }

          instances.forEach((inst) => {
            const doc = getInstDoc(inst);
            if (!doc) return;
            if (control === 'title') {
              const h = doc.querySelector('.hk-title');
              if (h) h.textContent = ctrl.value;
            } else if (control === 'description') {
              // v6.8/v6.10 usan clases propias para el mismo párrafo de
              // Bajada en vez de `hk-desc` — cubrir las 3 para que el
              // live-edit funcione en todas las variantes que la usan.
              const d = doc.querySelector('.hk-desc, .hk-paragraph-6-8, .hk-text-paragraph');
              if (d) d.innerHTML = ctrl.value;
            } else if (control === 'titleSupport') {
              const s = doc.querySelector('.hk-title-soporte');
              if (s) s.textContent = ctrl.value;
            }
          });
        };

        ctrl.addEventListener('input', apply);
        ctrl.addEventListener('change', apply);
      });

    // ── 4b. Cards editor (add / remove / live edit) ─────────────
    document.querySelectorAll('[data-cards-editor]').forEach((editor) => {
      const widgetId = editor.dataset.cardsEditor;
      if (!widgetId) return;

      // Live edit en cualquier campo de card → re-render (renderCards ya
      // notifica al widget dentro de cada iframe afectado).
      const notifyChange = () => {
        renderCards(widgetId);
      };
      editor.addEventListener('input', notifyChange);
      editor.addEventListener('change', notifyChange);

      // Eliminar card
      editor.addEventListener('click', (e) => {
        const target = e.target;
        const removeIdx = target.dataset.cardRemove;
        if (removeIdx === undefined) return;
        const row = editor.querySelector(`[data-card-row="${removeIdx}"]`);
        row?.remove();
        // Reindexar data-card-row para que sigan siendo únicos
        editor.querySelectorAll('[data-card-row]').forEach((r, i) => {
          r.setAttribute('data-card-row', String(i));
          r.querySelector('[data-card-remove]')?.setAttribute('data-card-remove', String(i));
        });
        notifyChange();
      });
    });

    // Botón "+ Agregar card"
    document.querySelectorAll('[data-card-add]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const widgetId = btn.dataset.cardAdd;
        if (!widgetId) return;
        const editor = document.querySelector(`[data-cards-editor="${widgetId}"]`);
        if (!editor) return;
        const template = btn.dataset.cardTemplate ?? 'std';
        const nextIdx = editor.querySelectorAll('[data-card-row]').length;
        const row = document.createElement('div');
        row.className = 'visor__card-row';
        row.setAttribute('data-card-row', String(nextIdx));
        if (template === 'cards6') {
          // Campos según el schema de la variante ACTIVA (no un template
          // fijo) — así una card nueva en v6.3 nace con sus 5 campos, y en
          // el resto de las variantes con los 3 default.
          const activeVariant = document
            .querySelector(`[data-preview-instance="${widgetId}"]:not([hidden])`)
            ?.dataset.previewVariant;
          const fields = getCard6Fields(widgetId, activeVariant);
          fields.forEach((field) => {
            const input = document.createElement('input');
            input.type = 'text';
            input.placeholder = field.label;
            input.setAttribute('aria-label', field.label);
            input.setAttribute('data-field-key', field.key);
            row.appendChild(input);
          });
          const removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'visor__card-remove';
          removeBtn.setAttribute('data-card-remove', String(nextIdx));
          removeBtn.setAttribute('aria-label', 'Eliminar card');
          removeBtn.textContent = '✕';
          row.appendChild(removeBtn);
        } else {
          row.innerHTML = `
            <select class="visor__card-icon" aria-label="Icono">
              <option value="fecha" selected>📅 Fecha</option>
              <option value="hora">🕐 Hora</option>
              <option value="presencial">👥 Presencial</option>
              <option value="virtual">📶 Virtual</option>
              <option value="hibrida">💻 Híbrida</option>
            </select>
            <input type="text" placeholder="Etiqueta (ej. Fecha:)" aria-label="Etiqueta" />
            <input type="text" placeholder="Valor (ej. 25 y 26 abril)" aria-label="Valor" />
            <button type="button" class="visor__card-remove" data-card-remove="${nextIdx}" aria-label="Eliminar card">✕</button>
          `;
        }
        editor.appendChild(row);
        // Re-index anteriores por seguridad
        editor.querySelectorAll('[data-card-row]').forEach((r, i) => {
          r.setAttribute('data-card-row', String(i));
        });
        renderCards(widgetId);
      });
    });

    // ── 4c. Mode switcher (light / dark por instancia) ─────────
    document
      .querySelectorAll('[data-mode-set]')
      .forEach((btn) => {
        btn.addEventListener('click', () => {
          const widgetId = btn.dataset.modeSet;
          const mode = btn.dataset.modeValue;
          if (!widgetId || !mode) return;

          // 1. Encontrar la variante actualmente visible para este widget
          //    (la única instancia sin `hidden`).
          const currentVariant = document
            .querySelector(`[data-preview-instance="${widgetId}"]:not([hidden])`)
            ?.dataset.previewVariant;

          // 2. Mostrar/ocultar las instancias correctas: misma variante,
          //    nuevo mode. Las demás (otras variantes) quedan ocultas.
          let newlyVisible = null;
          document
            .querySelectorAll(`[data-preview-instance="${widgetId}"]`)
            .forEach((inst) => {
              const matchesNew =
                inst.dataset.previewVariant === currentVariant &&
                inst.dataset.previewMode === mode;
              inst.hidden = !matchesNew;
              if (matchesNew) newlyVisible = inst;
            });

          // 3. Marcar botón activo en el switcher
          btn.parentElement
            ?.querySelectorAll('[data-mode-set]')
            .forEach((b) => {
              const isActive = b === btn;
              b.classList.toggle('is-active', isActive);
              b.setAttribute('aria-checked', String(isActive));
            });

          // 4. Notificar al widget (dentro de su iframe) para re-aplicar
          //    layouts y Swiper.
          const doc = getInstDoc(newlyVisible);
          doc?.dispatchEvent(
            new CustomEvent('visor:cards-changed', {
              detail: { widgetId, reason: 'mode-change' },
            })
          );
        });
      });

    // ── 5. Navegación del sidebar (mostrar un widget a la vez) ──
    const STORAGE_WIDGET = 'visor:widget';

    function showWidget(widgetId) {
      if (!widgetId) return;
      
      // Ocultar todos los panels y mostrar solo el seleccionado
      document.querySelectorAll('[data-widget-panel]').forEach((panel) => {
        const isActive = panel.dataset.widgetPanel === widgetId;
        panel.hidden = !isActive;
        panel.classList.toggle('is-hidden', !isActive);
      });

      // Marcar el link activo en el sidebar
      document.querySelectorAll('[data-widget-nav]').forEach((link) => {
        const isActive = link.dataset.widgetNav === widgetId;
        link.classList.toggle('is-active', isActive);
        if (isActive) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });

      // Cerrar el drawer de props al cambiar de widget
      document.querySelectorAll('[data-widget-body]').forEach((body) => {
        body.classList.remove('has-controls');
      });
      document.querySelectorAll('[data-edit-toggle]').forEach((btn) => {
        btn.classList.remove('is-active');
        btn.setAttribute('aria-pressed', 'false');
      });

      // Scroll al top del main
      const mainEl = document.querySelector('.visor__main');
      if (mainEl) {
        mainEl.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    document.querySelectorAll('[data-widget-nav]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const widgetId = a.dataset.widgetNav;
        if (!widgetId) return;
        e.preventDefault();
        console.log('Click en widget:', widgetId);
        showWidget(widgetId);
        localStorage.setItem(STORAGE_WIDGET, widgetId);
        console.log('Guardado en localStorage:', widgetId);
        console.log('Valor actual en localStorage:', localStorage.getItem(STORAGE_WIDGET));
        history.replaceState(null, '', `#${widgetId}`);
      });
    });

    // Restaurar widget seleccionado al cargar: prioridad = localStorage > hash > primer widget
    (function initWidget() {
      const storedWidget = localStorage.getItem(STORAGE_WIDGET);
      const hashWidget = location.hash.replace('#', '');
      
      // Buscar todos los widgets disponibles
      const allPanels = document.querySelectorAll('[data-widget-panel]');
      const firstWidget = allPanels[0]?.dataset.widgetPanel;
      
      console.log('=== INIT WIDGET ===');
      console.log('storedWidget:', storedWidget);
      console.log('hashWidget:', hashWidget);
      console.log('firstWidget:', firstWidget);
      console.log('allPanels:', Array.from(allPanels).map(p => p.dataset.widgetPanel));
      
      // Determinar qué widget mostrar
      let targetWidget = null;
      
      // 1. Primero intentar con localStorage
      if (storedWidget) {
        const existsInDom = Array.from(allPanels).some(p => p.dataset.widgetPanel === storedWidget);
        console.log('Checking storedWidget:', storedWidget, 'existsInDom:', existsInDom);
        if (existsInDom) {
          targetWidget = storedWidget;
        }
      }
      
      // 2. Si no hay localStorage, usar hash
      if (!targetWidget && hashWidget) {
        const existsInDom = Array.from(allPanels).some(p => p.dataset.widgetPanel === hashWidget);
        console.log('Checking hashWidget:', hashWidget, 'existsInDom:', existsInDom);
        if (existsInDom) {
          targetWidget = hashWidget;
        }
      }
      
      // 3. Si no hay nada, usar el primer widget
      if (!targetWidget && firstWidget) {
        targetWidget = firstWidget;
      }
      
      console.log('targetWidget seleccionado:', targetWidget);
      
      if (targetWidget) {
        showWidget(targetWidget);
        // Actualizar URL solo si es necesario
        if (location.hash.replace('#', '') !== targetWidget) {
          history.replaceState(null, '', `#${targetWidget}`);
        }
      }
    })();
  </script>
</BaseLayout>