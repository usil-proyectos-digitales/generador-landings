            </div>
            <h3 class:list={['font-montserrat text-mont-card-title hk-card-title !font-bold', tokens.cardTitle]} set:html={card.title} />
            <p class:list={['font-montserrat text-mont-card-text hk-card-text text-pretty', tokens.cardText]} set:html={card.text} />
            {card.ctaText && (
              <a href={card.ctaHref ?? '#'} class:list={['hk-card-cta inline-flex items-center gap-2 mt-4 px-6 py-2 border rounded-[2rem] font-montserrat text-mont-form-cta no-underline transition-all duration-300', tokens.cardCta]}>
                {card.ctaText}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
