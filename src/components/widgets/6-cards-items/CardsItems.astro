---
/**
 * CardsItems — Widget "Cards Items" (id: `6-cards-items`).
 * --------------------------------------------------------------
 * Migración a Astro del widget legacy en `src/migrar/6-cards-items/`.
 * Lógica preservada 1:1 desde `index.js`:
 *   - Layouts dinámicos en v6.3 / v6.6 / v6.11 / v6.12 según cantidad de cards.
 *   - Carrusel Swiper en v6.8 cuando hay más de 4 cards.
 *
 * Sistema de color:
 *   Tokens centralizados en `./theme.ts` por variante × modo.
 *   El widget consume las 5 variables semánticas del Design System V2.
 *
 * ACF (WordPress):
 *   - title       ← ACF `text`      "Título principal"
 *   - titleSupport← ACF `text`      "Texto de soporte (caja resaltada)"
 *   - description ← ACF `wysiwyg`   "Descripción / párrafo intro"
 *   - cards[]     ← ACF `repeater`  "Cards" (ver CardItem abajo)
 *   - variant     ← switch          ('v6.3' | 'v6.6' | 'v6.8' | 'v6.10' | 'v6.11' | 'v6.12')
 *   - mode        ← toggle          ('light' | 'dark')
 *
 * Comportamiento:
 *   - Cada variante ignora los campos de `card` que no necesita.
 *   - El ancho de las cards se ajusta por cantidad (lógica legacy preservada).
 *   - En v6.8, si hay >4 cards se inicializa Swiper como carrusel.
 *   - Las imágenes por default apuntan a placehold.co (editables en el visor).
 */
import { theme, baseClasses, type Mode, type Variant } from './theme.ts';

export interface CardItem {
  title: string;
  text: string;
  image?: string;
  icon?: string;
  ctaText?: string;
  ctaHref?: string;
  categoria?: string;
  precio?: string;
  periodo?: string;
}

interface Props {
  /** Título principal. */
  title: string;
  /** Texto dentro de la caja de soporte (resaltado). */
  titleSupport?: string;
  /** Descripción / párrafo intro (v6.6, v6.8, v6.10). */
  description?: string;
  /** Cards (repeater de ACF). */
  cards?: CardItem[];
  /** Variante visual. */
  variant?: Variant;
  /** Modo claro u oscuro. Default: 'light'. */
  mode?: Mode;
  /** ID del <section>. */
  id?: string;
}

const {
  title,
  titleSupport = '',
  description = '',
  cards = [],
  variant = 'v6.3',
  mode = 'light',
  id = 'cards-items',
} = Astro.props;

const tokens = theme[variant][mode];

// ── Helpers de layout dinámico (preservan lógica legacy) ─────
// v6.3: 2 cols en md, lg según cantidad (3 = 30%, 4 = 50%, otros = 50%)
const cardWidthV63 = (count: number) => {
  if (count === 4) return 'lg:w-[calc(50%-1rem)]';
  if (count % 3 === 0) return 'lg:w-[30%]';
  return 'lg:w-[calc(50%-2rem)]';
};

// v6.6: 1 col mobile, 2 cols md, lg según count (2/4 = 2 cols, resto = 3 cols)
const cardWidthV66 = (count: number) => {
  if (count === 4 || count === 2) return 'lg:w-[calc(50%-1rem)]';
  return 'lg:w-[calc((100%-4rem)/3)]';
};

// v6.11: similar a v6.3 pero con max-w-[400px]
const cardWidthV611 = (count: number) => {
  if (count === 4) return 'lg:w-[calc(50%-1rem)]';
  return 'lg:w-[calc((100%-4rem)/3)]';
};

// v6.12: similar a v6.11 pero con max-w-[350px]
const cardWidthV612 = (count: number) => {
  if (count === 4) return 'lg:w-[calc(50%-1rem)]';
  return 'lg:w-[calc((100%-4rem)/3)]';
};

const cardCount = cards?.length ?? 0;

// Helpers para decidir si aplicar carrusel (v6.8 con >4 cards)
const useCarouselV68 = variant === 'v6.8' && cardCount > 4;

// Defaults de placeholders para imágenes (placehold.co legacy)
const placeholderImg = (label: string) =>
  `https://placehold.co/270x184/012085/ffffff/?text=${encodeURIComponent(label)}`;
const placeholderImgLarge = (label: string) =>
  `https://placehold.co/530x242/012085/ffffff/?text=${encodeURIComponent(label)}`;

// Assets estáticos del widget (logos/iconos de plantilla).
// Las imágenes editables por card son `card.image` (placehold.co por default).
const WIDGET_ASSETS = '/widgets/6-cards-items';

// SVG arrow (CTA) — heredado del legacy, currentColor para que tome el color del BU
const svgArrow = `<svg class="svg-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>`;
---

<section
  id={id}
  data-widget="cards-items"
  data-variant={variant}
  data-mode={mode}
  class:list={[baseClasses.section, tokens.section]}
>
  <div class={baseClasses.container}>

    {/* ═══════════════════════════════════════════════════════════
        VARIANTE 6.3 — Título centrado + 3 cards verticales con CTA
        ═══════════════════════════════════════════════════════════ */}
    {variant === 'v6.3' && (
      <div data-variant-content="v6.3">
        <div class="mb-16 text-center">
          <h2 class:list={[
            'flex flex-col items-center mb-12 hk-title',
            baseClasses.titleFont,
            tokens.title,
          ]}>
            {title}
            {titleSupport && (
              <div class:list={[
                'inline-block px-6 py-2 mt-2 rounded-xl hk-caja-titulo',
                tokens.titleSupportBox,
              ]}>
                <span class:list={[
                  'block hk-title-soporte',
                  baseClasses.titleSupportFont,
                  tokens.titleSupport,
                ]}>{titleSupport}</span>
              </div>
            )}
          </h2>
          {description && (
            <p class:list={[
              'hk-desc w-full md:w-[90%] mx-auto text-pretty',
              baseClasses.bodyFont,
              tokens.desc,
              'text-mont-block-p-mobile md:text-mont-block-p',
            ]}>{description}</p>
          )}
        </div>
        <div class="flex flex-wrap gap-8 justify-center mx-auto">
          {cards.map((card) => (
            <div class:list={[
              'hk-card-6-3',
              baseClasses.cardBase,
              baseClasses.cardBaseMd,
              tokens.card,
              cardWidthV63(cardCount),
            ]}>
              <div class="flex gap-4 justify-center items-center">
                {/* Imagen opcional (ACF: icono 75×75px). Sin imagen, el
                    título ocupa todo el ancho — ver clase w-full abajo.
                    Se renderiza siempre con `hidden` (en vez de omitirse)
                    para que el live-edit del Visor solo tenga que alternar
                    visibilidad + src, sin crear/destruir el nodo. */}
                <img
                  src={card.icon ?? ''}
                  hidden={!card.icon}
                  class="hk-card-imagen w-[75px] h-[75px] object-contain shrink-0"
                  alt="Imagen del Card"
                />
                <h3 class:list={[
                  'hk-card-title',
                  baseClasses.cardTitleFont,
                  tokens.cardTitle,
                  !card.icon && 'w-full',
                ]}>{card.title}</h3>
              </div>
              <p class:list={[
                'text-left text-pretty hk-card-text',
                baseClasses.cardTextFont,
                tokens.cardText,
              ]}>{card.text}</p>
              {card.ctaText && (
                <a href={card.ctaHref ?? '#'} class:list={[
                  'btn-animacion hk-card-cta inline-flex items-center gap-2 !mt-8 px-6 py-2 border rounded-[2rem] no-underline transition-all duration-300 self-start',
                  baseClasses.cardCtaFont,
                  tokens.cardCta,
                ]}>
                  {card.ctaText}
                  <Fragment set:html={svgArrow} />
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    {/* ═══════════════════════════════════════════════════════════
        VARIANTE 6.6 — Título izq + cards horizontales (icono+texto)
        ═══════════════════════════════════════════════════════════ */}
    {variant === 'v6.6' && (
      <div data-variant-content="v6.6">
        <div class="mb-16 text-left">
          <h2 class:list={[
            'flex flex-col items-start mb-8 hk-title',
            baseClasses.titleFont,
            tokens.title,
          ]}>
            {title}
            {titleSupport && (
              <div class:list={[
                'inline-block px-6 py-2 mt-2 rounded-xl',
                tokens.titleSupportBox,
              ]}>
                <span class:list={[
                  'block hk-title-soporte',
                  baseClasses.titleSupportFont,
                  tokens.titleSupport,
                ]}>{titleSupport}</span>
              </div>
            )}
          </h2>
          {description && (
            <p class:list={[
              'hk-desc w-full md:w-[90%] text-pretty',
              baseClasses.bodyFont,
              tokens.desc,
              'text-mont-block-p-mobile md:text-mont-block-p',
            ]}>{description}</p>
          )}
        </div>
        <div class="hk-cards-container flex flex-wrap gap-x-8 gap-y-16 justify-center mx-auto w-full">
          {cards.map((card) => (
            <div class:list={[
              'hk-card-6-6 flex gap-3 justify-center items-center w-full md:w-[calc(50%-1rem)]',
              cardWidthV66(cardCount),
            ]}>
              <div class:list={[
                'hk-box-imagen flex shrink-0 justify-center items-center w-[75px] h-[75px] rounded-full',
                tokens.cardIconBox,
              ]}>
                <img src={card.icon ?? `${WIDGET_ASSETS}/card_imagen.webp`} class="hk-card-imagen w-[45px]" alt="Imagen del Card" />
              </div>
              <div class="box-texto">
                <h3 class:list={[
                  'hk-card-title',
                  baseClasses.cardTitleFont,
                  tokens.cardTitle,
                ]}>{card.title}</h3>
                <p class:list={[
                  'hk-card-text',
                  baseClasses.cardItemTextFont,
                  tokens.cardText,
                ]}>{card.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* ═══════════════════════════════════════════════════════════
        VARIANTE 6.8 — Título izq + cards verticales con imagen
        (carrusel Swiper si >4 cards)
        ═══════════════════════════════════════════════════════════ */}
    {variant === 'v6.8' && (
      <div data-variant-content="v6.8">
        <div class="mb-16 text-left hk-header-container-6-8">
          <h2 class:list={[
            'flex flex-col items-start hk-title-6-8',
            baseClasses.titleFont,
            tokens.title,
          ]}>{title}</h2>
          <div class:list={[
            'my-6 mr-auto w-40 h-1 rounded-full hk-header-bar-6-8',
            tokens.bar,
          ]}></div>
          {description && (
            <p class:list={[
              'hk-paragraph-6-8 w-full text-left text-pretty',
              baseClasses.bodyFont,
              tokens.desc,
              'text-mont-block-p-mobile md:text-mont-block-p',
            ]}>{description}</p>
          )}
        </div>
        <div
          class:list={[
            'hk-cards-grid-v6-8 mx-auto',
            useCarouselV68 ? 'hk-cards-carousel swiper' : 'flex flex-wrap gap-4 justify-center max-w-[270px] md:max-w-[560px] lg:max-w-[850px] xl:max-w-[1140px]',
          ]}
          data-carousel-enabled={useCarouselV68 ? 'true' : 'false'}
        >
          {useCarouselV68 ? (
            <Fragment>
            <div class="swiper-wrapper">
              {cards.map((card) => (
                <div class:list={[
                  'swiper-slide hk-card-6-8 mx-auto group',
                ]}>
                  <div class="overflow-hidden relative rounded-t-2xl">
                    <img src={card.image ?? placeholderImg(card.title || 'Card')} class="w-full max-w-[270px] mx-auto h-[184px] object-cover transition-transform duration-500 hk-card-imagen-6-8 lg:group-hover:scale-110" alt="Imagen del card" />
                    <a href={card.ctaHref ?? '#'} class:list={[
                      'hidden absolute inset-0 flex-col justify-center items-center opacity-0 transition-all duration-500 translate-y-full lg:flex group-hover:translate-y-0 group-hover:opacity-100',
                      tokens.imageOverlay,
                    ]}>
<img src={`${WIDGET_ASSETS}/ver_mas.webp`} class="mb-2" alt="Ver más icon" />
                      <span class="text-sm font-medium tracking-wider text-bu-surface hk-vermas-texto">Ver más</span>
                    </a>
                  </div>
                  <div class:list={['p-4 rounded-b-2xl hk-box-texto', tokens.card]}>
                    <h3 class:list={[
                      'hk-card-title',
                      baseClasses.cardTitleFontAnton,
                      tokens.cardTitle,
                    ]}>{card.title}</h3>
                    <div class:list={['my-3 w-14 h-1 rounded-full', tokens.bar]}></div>
                    <a href={card.ctaHref ?? '#'} class="inline-block mt-2 text-sm font-bold no-underline uppercase text-bu-primary lg:hidden">Ver más</a>
                  </div>
                </div>
              ))}
            </div>
            {/* Flechas + dots del carrusel — se muestran apenas Swiper se
                inicializa (>4 cards). El CSS de Swiper (cargado por
                initCarouselV68) ya los estiliza; solo pisamos el color
                para que sigan la paleta de la BU en vez del azul default. */}
            <div class="swiper-button-prev" aria-label="Anterior"></div>
            <div class="swiper-button-next" aria-label="Siguiente"></div>
            <div class="swiper-pagination"></div>
            </Fragment>
          ) : (
            cards.map((card) => (
              <div class:list={[
                'hk-card-6-8 lg:w-[calc((100%-3rem)/4)] md:w-[calc((100%-1rem)/2)] w-full max-w-[270px] mx-auto group',
              ]}>
                <div class="overflow-hidden relative rounded-t-2xl">
                  <img src={card.image ?? placeholderImg(card.title || 'Card')} class="w-full max-w-[270px] mx-auto h-[184px] object-cover transition-transform duration-500 hk-card-imagen-6-8 lg:group-hover:scale-110" alt="Imagen del card" />
                  <a href={card.ctaHref ?? '#'} class:list={[
                    'hidden absolute inset-0 flex-col justify-center items-center opacity-0 transition-all duration-500 translate-y-full lg:flex group-hover:translate-y-0 group-hover:opacity-100',
                    tokens.imageOverlay,
                  ]}>
                    <img src={`${WIDGET_ASSETS}/ver_mas.webp`} class="mb-2" alt="Ver más icon" />
                    <span class="text-sm font-medium tracking-wider text-bu-surface hk-vermas-texto">Ver más</span>
                  </a>
                </div>
                <div class:list={['p-4 rounded-b-2xl hk-box-texto', tokens.card]}>
                  <h3 class:list={[
                    'hk-card-title',
                    baseClasses.cardTitleFontAnton,
                    tokens.cardTitle,
                  ]}>{card.title}</h3>
                  <div class:list={['my-3 w-14 h-1 rounded-full', tokens.bar]}></div>
                  <a href={card.ctaHref ?? '#'} class="inline-block mt-2 text-sm font-bold no-underline uppercase text-bu-primary lg:hidden">Ver más</a>
                </div>
              </div>
            ))
          )}
        </div>
      </div>
    )}

    {/* ═══════════════════════════════════════════════════════════
        VARIANTE 6.10 — Título izq + 2 cards grandes con CTA
        ═══════════════════════════════════════════════════════════ */}
    {variant === 'v6.10' && (
      <div data-variant-content="v6.10">
        <div class="mb-16 text-left">
          <h2 class:list={[
            'flex flex-col items-start mb-8 hk-title',
            baseClasses.titleFont,
            tokens.title,
          ]}>
            {title}
            {titleSupport && (
              <div class:list={[
                'inline-block px-6 py-2 mt-2 rounded-xl',
                tokens.titleSupportBox,
              ]}>
                <span class:list={[
                  'block hk-title-soporte',
                  baseClasses.titleSupportFont,
                  tokens.titleSupport,
                ]}>{titleSupport}</span>
              </div>
            )}
          </h2>
          {description && (
            <p class:list={[
              'hk-text-paragraph w-full md:w-[90%] text-pretty',
              baseClasses.bodyFont,
              tokens.desc,
              'text-mont-block-p-mobile md:text-mont-block-p',
            ]}>{description}</p>
          )}
        </div>
        <div class="flex flex-wrap gap-8 justify-center mx-auto">
          {cards.map((card) => (
            <div class:list={['hk-card-6-10', baseClasses.cardBaseV610]}>
              <div class="overflow-hidden relative rounded-t-[2rem]">
                <img src={card.image ?? placeholderImgLarge(card.title || 'Card')} class="w-full transition-transform duration-500 hk-card-imagen lg:group-hover:scale-110" alt="Imagen del card" />
              </div>
              <div class={baseClasses.cardBoxV610}>
                <h3 class:list={[
                  'hk-card-title',
                  baseClasses.cardTitleFont,
                  tokens.cardTitle,
                ]}>{card.title}</h3>
                <p class:list={[
                  'hk-card-text text-pretty',
                  baseClasses.cardTextFont,
                  tokens.cardText,
                ]}>{card.text}</p>
                {card.ctaText && (
                  <a href={card.ctaHref ?? '#'} class:list={[
                    'btn-animacion hk-card-cta inline-flex items-center gap-2 mt-4 px-6 py-2 border rounded-[2rem] no-underline transition-all duration-300',
                    baseClasses.cardCtaFontAntonio,
                    tokens.cardCta,
                  ]}>
                    {card.ctaText}
                    <Fragment set:html={svgArrow} />
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* ═══════════════════════════════════════════════════════════
        VARIANTE 6.11 — Título centrado + cards producto (cat/precio)
        ═══════════════════════════════════════════════════════════ */}
    {variant === 'v6.11' && (
      <div data-variant-content="v6.11">
        <div class="mb-16 text-center">
          <h2 class:list={[
            'flex flex-col items-center mb-12 hk-title',
            baseClasses.titleFont,
            tokens.title,
          ]}>
            {title}
            {titleSupport && (
              <div class:list={[
                'inline-block px-6 py-2 mt-2 rounded-xl hk-caja-titulo',
                tokens.titleSupportBox,
              ]}>
                <span class:list={[
                  'block hk-title-soporte',
                  baseClasses.titleSupportFont,
                  tokens.titleSupport,
                ]}>{titleSupport}</span>
              </div>
            )}
          </h2>
          {description && (
            <p class:list={[
              'hk-desc w-full md:w-[90%] mx-auto text-pretty',
              baseClasses.bodyFont,
              tokens.desc,
              'text-mont-block-p-mobile md:text-mont-block-p',
            ]}>{description}</p>
          )}
        </div>
        <div class="flex flex-wrap gap-8 justify-center mx-auto">
          {cards.map((card) => (
            <div class:list={[
              'hk-card-6-11',
              baseClasses.cardBaseV611,
              baseClasses.cardBaseV611Lg,
              cardWidthV611(cardCount),
              tokens.card,
            ]}>
              <div class="w-full">
                <span class:list={[
                  'text-left hk-card-title-categoria',
                  baseClasses.cardTitleFont,
                  tokens.cardTitle,
                ]}>{card.categoria ?? 'Categoria'}</span>
                <div class="w-full h-[1px] bg-bu-surface my-2"></div>
              </div>
              <h3 class:list={[
                'text-left hk-card-title',
                baseClasses.cardTextFont,
                tokens.cardTitle,
              ]}>{card.title}</h3>
              <div class="w-full h-[1px] bg-bu-surface my-4"></div>
              <p class:list={[
                'm-0 text-left hk-card-text text-balance leading-[1.2]',
                baseClasses.cardTextFont,
                tokens.cardText,
              ]}>
                <span class="hk-precio-texto">Precio:</span><br />
                <span class="hk-precio-monto">{card.precio ?? 'S/ xxx.xx'}</span>
              </p>
              {card.ctaText && (
                <a href={card.ctaHref ?? '#'} class:list={[
                  'btn-animacion hk-card-cta inline-flex items-center gap-2 mt-4 px-6 py-2 border rounded-[2rem] no-underline transition-all duration-300',
                  baseClasses.cardCtaFont,
                  tokens.cardCta,
                ]}>
                  {card.ctaText}
                  <Fragment set:html={svgArrow} />
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    {/* ═══════════════════════════════════════════════════════════
        VARIANTE 6.12 — Título centrado + cards con badge de fecha
        ═══════════════════════════════════════════════════════════ */}
    {variant === 'v6.12' && (
      <div data-variant-content="v6.12">
        <div class="mb-16 text-center">
          <h2 class:list={[
            'flex flex-col items-center mb-12 hk-title',
            baseClasses.titleFont,
            tokens.title,
          ]}>
            {title}
            {titleSupport && (
              <div class:list={[
                'inline-block px-6 py-2 mt-2 rounded-xl hk-caja-titulo',
                tokens.titleSupportBox,
              ]}>
                <span class:list={[
                  'block hk-title-soporte',
                  baseClasses.titleSupportFont,
                  tokens.titleSupport,
                ]}>{titleSupport}</span>
              </div>
            )}
          </h2>
          {description && (
            <p class:list={[
              'hk-desc w-full md:w-[90%] mx-auto text-pretty',
              baseClasses.bodyFont,
              tokens.desc,
              'text-mont-block-p-mobile md:text-mont-block-p',
            ]}>{description}</p>
          )}
        </div>
        <div class="flex flex-wrap gap-8 justify-center mx-auto">
          {cards.map((card) => (
            <div class:list={[
              'hk-card-6-12',
              baseClasses.cardBaseV612,
              baseClasses.cardBaseV612Lg,
              cardWidthV612(cardCount),
              tokens.card,
            ]}>
              <div class="flex gap-3 items-center px-4 py-1 bg-bu-surface rounded-lg hk-date-badge">
                <img src={`${WIDGET_ASSETS}/mini_calendario.webp`} class="hk-date-icon" alt="Calendario" />
                <p class:list={[
                  'hk-card-periodo font-montserrat font-bold text-[1.12rem] hk-date-text',
                  tokens.dateBadgeText,
                ]}>{card.periodo ?? 'Del xx/xx al xx/xx'}</p>
              </div>
              <h3 class:list={[
                '!font-bold hk-card-title',
                baseClasses.cardTitleFont,
                tokens.cardTitle,
              ]}>{card.title}</h3>
              <p class:list={[
                'hk-card-text text-pretty',
                'font-montserrat text-mont-card-text',
                tokens.cardText,
              ]}>{card.text}</p>
              {card.ctaText && (
                <a href={card.ctaHref ?? '#'} class:list={[
                  'btn-animacion hk-card-cta inline-flex items-center gap-2 mt-4 px-6 py-2 border rounded-[2rem] no-underline transition-all duration-300',
                  baseClasses.cardCtaFont,
                  tokens.cardCta,
                ]}>
                  {card.ctaText}
                  <Fragment set:html={svgArrow} />
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

  </div>
</section>

<style>
  /* Flechas + dots del carrusel v6.8 heredan la paleta de la BU en vez del
     azul default de Swiper — Swiper resuelve ambos desde esta única
     variable (ver swiper-bundle.min.css). */
  .hk-cards-grid-v6-8 {
    --swiper-theme-color: var(--bu-color-brand-primary);
  }
</style>

{/* ============================================================
    Script cliente — preserva la lógica legacy:
      - v6.8 con >4 cards  → inicializa Swiper
      - v6.3/6.6/6.11/6.12  → ajusta anchos según cantidad
    ============================================================ */}
<script>
  // ── Swiper loader (lazy, desde CDN) ──────────────────────
  // Se inyecta solo si la página tiene al menos un widget v6.8
  // con >4 cards. Mantiene aislado el bundle principal.
  const SWIPER_VERSION = '11.1.14';
  const SWIPER_CSS = `https://cdn.jsdelivr.net/npm/swiper@${SWIPER_VERSION}/swiper-bundle.min.css`;
  const SWIPER_JS = `https://cdn.jsdelivr.net/npm/swiper@${SWIPER_VERSION}/swiper-bundle.min.js`;

  function loadSwiper(): Promise<void> {
    return new Promise((resolve) => {
      if ((window as any).Swiper) return resolve();
      if (document.querySelector(`link[href="${SWIPER_CSS}"]`)) return resolve();
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = SWIPER_CSS;
      document.head.appendChild(link);
      const script = document.createElement('script');
      script.src = SWIPER_JS;
      script.onload = () => resolve();
      document.body.appendChild(script);
    });
  }

  // ── v6.8 — Carrusel si >4 cards ─────────────────────────
  // Mapa para trackear instancias Swiper y poder destruirlas antes de re-inicializar.
  const swiperInstances = new WeakMap<HTMLElement, any>();

  // Clases exclusivas de cada modo — deben espejar el markup SSR de arriba
  // (bloque `useCarouselV68 ? ... : ...`). Cuando la cantidad de cards
  // cruza el umbral de 4 en runtime (ej. agregando/quitando cards desde el
  // Visor), hay que alternar entre ambos modos SIMÉTRICAMENTE: no alcanza
  // con agregar/quitar la clase `swiper` del contenedor, también hay que
  // envolver/desenvolver las cards en `.swiper-wrapper` y actualizar las
  // clases de ancho de cada card — si no, queda una mezcla rota (contenedor
  // sin layout, o cards con `swiper-slide` fuera de un wrapper real).
  const V68_GRID_FLEX_CLASSES = [
    'flex', 'flex-wrap', 'gap-4', 'justify-center',
    'max-w-[270px]', 'md:max-w-[560px]', 'lg:max-w-[850px]', 'xl:max-w-[1140px]',
  ];
  const V68_GRID_CAROUSEL_CLASSES = ['hk-cards-carousel', 'swiper'];
  const V68_CARD_FLEX_CLASSES = [
    'lg:w-[calc((100%-3rem)/4)]', 'md:w-[calc((100%-1rem)/2)]', 'w-full', 'max-w-[270px]',
  ];
  const V68_CARD_CAROUSEL_CLASS = 'swiper-slide';

  // Reconcilia SIEMPRE la estructura/clases al modo pedido — idempotente,
  // así una card recién clonada (que puede traer clases del modo viejo, si
  // el template capturado por el Visor quedó desactualizado) también se
  // corrige, no solo las que estaban presentes al cruzar el umbral.
  function setV68Mode(container: HTMLElement, wantCarousel: boolean) {
    const doc = container.ownerDocument;
    const cards = Array.from(
      container.querySelectorAll<HTMLElement>(
        ':scope > .hk-card-6-8, :scope > .swiper-wrapper > .hk-card-6-8'
      )
    );

    if (wantCarousel) {
      let wrapper = container.querySelector<HTMLElement>(':scope > .swiper-wrapper');
      if (!wrapper) {
        wrapper = doc.createElement('div');
        wrapper.className = 'swiper-wrapper';
        container.appendChild(wrapper);
      }
      cards.forEach((card) => {
        card.classList.remove(...V68_CARD_FLEX_CLASSES);
        card.classList.add(V68_CARD_CAROUSEL_CLASS);
        if (card.parentElement !== wrapper) wrapper!.appendChild(card);
      });
      container.classList.remove(...V68_GRID_FLEX_CLASSES);
      container.classList.add(...V68_GRID_CAROUSEL_CLASSES);
      container.dataset.carouselEnabled = 'true';

      // Flechas + dots — el markup SSR ya los trae cuando la variante
      // arranca en modo carrusel; si arrancó en modo flex y recién ahora
      // cruza el umbral, hay que crearlos.
      if (!container.querySelector(':scope > .swiper-button-prev')) {
        const prevBtn = doc.createElement('div');
        prevBtn.className = 'swiper-button-prev';
        prevBtn.setAttribute('aria-label', 'Anterior');
        container.appendChild(prevBtn);
      }
      if (!container.querySelector(':scope > .swiper-button-next')) {
        const nextBtn = doc.createElement('div');
        nextBtn.className = 'swiper-button-next';
        nextBtn.setAttribute('aria-label', 'Siguiente');
        container.appendChild(nextBtn);
      }
      if (!container.querySelector(':scope > .swiper-pagination')) {
        const pagination = doc.createElement('div');
        pagination.className = 'swiper-pagination';
        container.appendChild(pagination);
      }
    } else {
      cards.forEach((card) => {
        card.classList.remove(V68_CARD_CAROUSEL_CLASS);
        card.classList.add(...V68_CARD_FLEX_CLASSES);
        if (card.parentElement !== container) container.appendChild(card);
      });
      container.querySelector(':scope > .swiper-wrapper')?.remove();
      container.querySelector(':scope > .swiper-button-prev')?.remove();
      container.querySelector(':scope > .swiper-button-next')?.remove();
      container.querySelector(':scope > .swiper-pagination')?.remove();
      container.classList.remove(...V68_GRID_CAROUSEL_CLASSES, 'swiper-initialized');
      container.classList.add(...V68_GRID_FLEX_CLASSES);
      container.dataset.carouselEnabled = 'false';
    }
  }

  async function initCarouselV68() {
    const sections = document.querySelectorAll<HTMLElement>(
      'section[data-widget="cards-items"][data-variant="v6.8"]'
    );
    for (const section of sections) {
      const container = section.querySelector<HTMLElement>('.hk-cards-grid-v6-8');
      if (!container) continue;
      const cardCount = container.querySelectorAll('.hk-card-6-8').length;

      // Si pasamos a ≤4, destruir Swiper y volver al grid flex (estructura
      // y clases incluidas, no solo la clase `swiper`).
      if (cardCount <= 4) {
        const swiper = swiperInstances.get(container);
        if (swiper && swiper.destroy) {
          swiper.destroy(true, true);
          swiperInstances.delete(container);
        }
        setV68Mode(container, false);
        continue;
      }

      // Si ya hay un Swiper, destruir antes de re-crear (evita duplicados).
      const existing = swiperInstances.get(container);
      if (existing && existing.destroy) {
        existing.destroy(true, true);
        swiperInstances.delete(container);
      }

      setV68Mode(container, true);

      await loadSwiper();
      // nextEl/prevEl/pagination.el apuntan a los elementos DE ESTA
      // instancia puntual (no un selector global de clase) — así conviven
      // varios v6.8 con carrusel en la misma página sin pisarse.
      const swiper = new (window as any).Swiper(container, {
        centeredSlides: false,
        navigation: {
          nextEl: container.querySelector<HTMLElement>(':scope > .swiper-button-next'),
          prevEl: container.querySelector<HTMLElement>(':scope > .swiper-button-prev'),
        },
        pagination: {
          el: container.querySelector<HTMLElement>(':scope > .swiper-pagination'),
          clickable: true,
        },
        breakpoints: {
          576: { slidesPerView: 2, centeredSlides: false, spaceBetween: 20 },
          1000: { slidesPerView: 4, centeredSlides: false, spaceBetween: 32 },
        },
      });
      swiperInstances.set(container, swiper);
    }
  }

  // ── Layouts dinámicos por variante ───────────────────────
  function setCardWidths(
    selector: string,
    containerSelector: string,
    widthFor: (count: number) => string
  ) {
    const sections = document.querySelectorAll<HTMLElement>(selector);
    sections.forEach((section) => {
      const container =
        section.querySelector<HTMLElement>(containerSelector) ||
        section.querySelector<HTMLElement>('.flex.flex-wrap.gap-8');
      if (!container) return;
      const cards = Array.from(container.children).filter(
        (el) => el.tagName === 'DIV'
      ) as HTMLElement[];
      const count = cards.length;
      cards.forEach((card) => {
        card.className = card.className
          .split(' ')
          .filter(
            (c) =>
              !c.startsWith('lg:w-') &&
              !c.startsWith('md:w-') &&
              !c.startsWith('w-full') &&
              !c.startsWith('max-w-')
          )
          .join(' ');
        card.classList.add('w-full', 'md:w-[calc(50%-1rem)]');
        card.classList.add(widthFor(count));
      });
    });
  }

  function applyDynamicLayouts() {
    setCardWidths(
      'section[data-widget="cards-items"][data-variant="v6.3"]',
      '.hk-cards-grid-v6-3, .flex.flex-wrap.gap-8',
      (count) => {
        if (count === 4) return 'lg:w-[calc(50%-1rem)]';
        if (count % 3 === 0) return 'lg:w-[30%]';
        return 'lg:w-[calc(50%-2rem)]';
      }
    );
    setCardWidths(
      'section[data-widget="cards-items"][data-variant="v6.6"]',
      '.hk-cards-container',
      (count) =>
        count === 4 || count === 2
          ? 'lg:w-[calc(50%-1rem)]'
          : 'lg:w-[calc((100%-4rem)/3)]'
    );
    setCardWidths(
      'section[data-widget="cards-items"][data-variant="v6.11"]',
      '.hk-cards-container, .flex.flex-wrap.gap-8',
      (count) =>
        count === 4
          ? 'lg:w-[calc(50%-1rem)]'
          : 'lg:w-[calc((100%-4rem)/3)]'
    );
    setCardWidths(
      'section[data-widget="cards-items"][data-variant="v6.12"]',
      '.hk-cards-container, .flex.flex-wrap.gap-8',
      (count) =>
        count === 4
          ? 'lg:w-[calc(50%-1rem)]'
          : 'lg:w-[calc((100%-4rem)/3)]'
    );
  }

  // Ejecutar al cargar (las cards ya vienen con anchos por defecto desde SSR,
  // el script solo los recalcula según el conteo real).
  applyDynamicLayouts();
  initCarouselV68();

  // Re-aplicar cuando cambia el viewport o se re-renderiza el visor.
  document.addEventListener('astro:page-load', () => {
    applyDynamicLayouts();
    initCarouselV68();
  });

  // Listener del editor de cards del visor: cuando el usuario
  // agrega/elimina/edita cards, re-aplicar layouts y Swiper.
  document.addEventListener('visor:cards-changed', (e: Event) => {
    const detail = (e as CustomEvent).detail;
    if (detail?.widgetId !== '6-cards-items') return;
    applyDynamicLayouts();
    initCarouselV68();
  });
</script>