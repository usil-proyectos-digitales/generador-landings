[{"id":"4f3066a","elType":"container","settings":{"container_type":"flex","content_width":"full","background_background":"classic","background_color":"#f4f6fb","padding":{"unit":"px","top":"40","right":"20","bottom":"60","left":"20","isLinked":false},"flex_align_items":"stretch","flex_direction":"column"},"elements":[{"id":"68ab4c9","elType":"widget","settings":{"html":"<div id=\"usil-wizard-mockup\" style=\"--bu-primary:#1e50dc;--bu-secondary:#002663;--bu-accent:#817aff;--bu-surface:#DFE8F7;--bu-neutral:#ffffff; font-family:'Montserrat',sans-serif; width:100%; margin:0; background:var(--bu-neutral); border-radius:0; box-shadow:none; overflow:hidden; box-sizing:border-box;\">\n\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Anton&display=swap\" rel=\"stylesheet\">\n\n  <!-- Barra superior -->\n  <div style=\"background:var(--bu-secondary); color:#fff; padding:16px 28px; display:flex; align-items:center; justify-content:space-between;\">\n    <div style=\"font-family:'Anton',sans-serif; font-size:20px; letter-spacing:0.5px;\">Generador de Landings USIL</div>\n    <div id=\"uw-stepper\" style=\"display:flex; gap:10px; font-size:13px; font-weight:600;\"></div>\n  </div>\n\n  <!-- ===================== PANTALLA 1: Preguntas clave ===================== -->\n  <section id=\"uw-screen-1\" class=\"uw-screen\" style=\"padding:36px 32px;\">\n   <div style=\"max-width:640px; margin:0 auto;\">\n    <p style=\"text-transform:uppercase; letter-spacing:1px; color:var(--bu-primary); font-weight:700; font-size:12px; margin:0 0 6px;\">Paso 1 de 4</p>\n    <h2 style=\"font-family:'Anton',sans-serif; color:var(--bu-secondary); font-size:28px; margin:0 0 20px;\">Contanos sobre tu landing</h2>\n\n    <label style=\"display:block; font-weight:600; font-size:14px; color:var(--bu-secondary); margin-bottom:6px;\">Unidad de Negocio</label>\n    <select id=\"uw-bu\" style=\"width:100%; padding:12px 14px; border:1.5px solid var(--bu-surface); border-radius:10px; font-size:14px; margin-bottom:18px; background:#fff;\">\n      <option>Pregrado</option>\n      <option>Pregrado Ejecutivo</option>\n      <option>Instituto de Emprendedores</option>\n      <option>Posgrado</option>\n      <option>CSIR</option>\n      <option>SIU</option>\n    </select>\n\n    <label style=\"display:block; font-weight:600; font-size:14px; color:var(--bu-secondary); margin-bottom:6px;\">Objetivo de la landing</label>\n    <input value=\"Captar postulantes para Admisión 2026 — Ingeniería de Software\" style=\"width:100%; padding:12px 14px; border:1.5px solid var(--bu-surface); border-radius:10px; font-size:14px; margin-bottom:18px;\">\n\n    <label style=\"display:block; font-weight:600; font-size:14px; color:var(--bu-secondary); margin-bottom:6px;\">Título / propuesta</label>\n    <input value=\"Admisión 2026 — Ingeniería de Software\" style=\"width:100%; padding:12px 14px; border:1.5px solid var(--bu-surface); border-radius:10px; font-size:14px; margin-bottom:18px;\">\n\n    <label style=\"display:block; font-weight:600; font-size:14px; color:var(--bu-secondary); margin-bottom:6px;\">Oferta / dato clave</label>\n    <input value=\"Becas disponibles para los primeros 50 postulantes\" style=\"width:100%; padding:12px 14px; border:1.5px solid var(--bu-surface); border-radius:10px; font-size:14px; margin-bottom:18px;\">\n\n    <label style=\"display:block; font-weight:600; font-size:14px; color:var(--bu-secondary); margin-bottom:6px;\">Llamado a la acción (CTA)</label>\n    <input value=\"Postula ahora\" style=\"width:100%; padding:12px 14px; border:1.5px solid var(--bu-surface); border-radius:10px; font-size:14px; margin-bottom:18px;\">\n\n    <label style=\"display:block; font-weight:600; font-size:14px; color:var(--bu-secondary); margin-bottom:6px;\">Texto libre / tono (opcional)</label>\n    <textarea rows=\"3\" style=\"width:100%; padding:12px 14px; border:1.5px solid var(--bu-surface); border-radius:10px; font-size:14px; margin-bottom:18px; font-family:inherit;\">Tono cercano, enfocado en empleabilidad. Mencionar laboratorios y convenios con empresas tech.</textarea>\n\n    <label style=\"display:flex; align-items:center; gap:10px; padding:14px; border:1.5px dashed var(--bu-primary); border-radius:10px; background:var(--bu-surface); cursor:pointer; margin-bottom:24px;\">\n      <span style=\"font-size:20px;\">📎</span>\n      <span style=\"font-size:13px; color:var(--bu-secondary);\"><strong>brief-admision-2026.docx</strong><br>Documento adjunto (opcional) — contenido ya preparado por Marketing</span>\n    </label>\n\n    <button onclick=\"uwGo(2)\" style=\"background:var(--bu-primary); color:#fff; border:none; padding:14px 28px; border-radius:30px; font-weight:700; font-size:15px; cursor:pointer; float:right;\">Generar preview →</button>\n    <div style=\"clear:both;\"></div>\n   </div>\n  </section>\n\n  <!-- ===================== PANTALLA 2: Thinking UI ===================== -->\n  <section id=\"uw-screen-2\" class=\"uw-screen\" style=\"display:none; padding:60px 32px; text-align:center;\">\n    <div style=\"width:56px; height:56px; border:5px solid var(--bu-surface); border-top-color:var(--bu-primary); border-radius:50%; margin:0 auto 28px; animation:uwspin 1s linear infinite;\"></div>\n    <h2 style=\"font-family:'Anton',sans-serif; color:var(--bu-secondary); font-size:24px; margin:0 0 28px;\">Armando tu landing…</h2>\n    <div id=\"uw-steps\" style=\"max-width:380px; margin:0 auto; text-align:left;\"></div>\n  </section>\n\n  <!-- ===================== PANTALLA 3: Resultado IA ===================== -->\n  <section id=\"uw-screen-3\" class=\"uw-screen\" style=\"display:none; padding:36px 32px;\">\n   <div style=\"max-width:640px; margin:0 auto;\">\n    <p style=\"text-transform:uppercase; letter-spacing:1px; color:var(--bu-primary); font-weight:700; font-size:12px; margin:0 0 6px;\">Paso 3 de 4</p>\n    <h2 style=\"font-family:'Anton',sans-serif; color:var(--bu-secondary); font-size:26px; margin:0 0 24px;\">Esto detectó la IA</h2>\n\n    <div style=\"display:flex; gap:20px; flex-wrap:wrap; margin-bottom:24px;\">\n      <div style=\"flex:1; min-width:220px; background:var(--bu-surface); border-radius:14px; padding:18px 20px;\">\n        <p style=\"margin:0 0 4px; font-size:12px; font-weight:700; color:var(--bu-secondary); text-transform:uppercase;\">Unidad de Negocio</p>\n        <p style=\"margin:0; font-size:18px; font-weight:800; color:var(--bu-primary);\">Pregrado <a href=\"#\" onclick=\"uwGo(1);return false;\" style=\"font-size:12px; font-weight:600; color:var(--bu-secondary); margin-left:8px;\">(corregir)</a></p>\n      </div>\n      <div style=\"flex:1; min-width:220px; background:var(--bu-surface); border-radius:14px; padding:18px 20px;\">\n        <p style=\"margin:0 0 4px; font-size:12px; font-weight:700; color:var(--bu-secondary); text-transform:uppercase;\">Secciones elegidas</p>\n        <p style=\"margin:0; font-size:14px; color:var(--bu-secondary); line-height:1.6;\">Header · Intro · Cards (beneficios) · Testimonio · Save the date · Formulario · Footer</p>\n      </div>\n    </div>\n\n    <button onclick=\"uwGo(4)\" style=\"background:var(--bu-primary); color:#fff; border:none; padding:14px 28px; border-radius:30px; font-weight:700; font-size:15px; cursor:pointer; float:right;\">Ver preview →</button>\n    <div style=\"clear:both;\"></div>\n   </div>\n  </section>\n\n  <!-- ===================== PANTALLA 4: Visor de preview ===================== -->\n  <section id=\"uw-screen-4\" class=\"uw-screen\" style=\"display:none;\">\n    <div style=\"padding:20px 32px 0;\">\n      <p style=\"text-transform:uppercase; letter-spacing:1px; color:var(--bu-primary); font-weight:700; font-size:12px; margin:0 0 6px;\">Paso 4 de 4</p>\n      <h2 style=\"font-family:'Anton',sans-serif; color:var(--bu-secondary); font-size:24px; margin:0 0 16px;\">Revisá tu preview</h2>\n    </div>\n\n    <div style=\"display:flex; gap:0; align-items:flex-start;\">\n      <!-- Toolbar + iframe -->\n      <div style=\"flex:1; min-width:0; padding:0 0 24px 32px;\">\n        <div style=\"display:flex; gap:8px; margin-bottom:12px;\">\n          <button id=\"uw-vp-desktop\" onclick=\"uwSetViewport('desktop')\" style=\"padding:6px 14px; border:1.5px solid var(--bu-surface); border-radius:8px; background:#fff; font-size:13px; font-weight:600; cursor:pointer;\">🖥️ Desktop</button>\n          <button id=\"uw-vp-mobile\" onclick=\"uwSetViewport('mobile')\" style=\"padding:6px 14px; border:1.5px solid var(--bu-surface); border-radius:8px; background:#fff; font-size:13px; font-weight:600; cursor:pointer;\">📱 Mobile</button>\n        </div>\n        <div id=\"uw-frame-wrap\" style=\"border:1.5px solid var(--bu-surface); border-radius:14px; overflow:hidden; background:#f4f6fb;\">\n          <iframe id=\"uw-preview-frame\" src=\"https://proyectos.usil.digital/dev/landings-usil/demo-admision-2026-pregrado/\" style=\"width:100%; height:760px; border:0; display:block;\"></iframe>\n        </div>\n        <p style=\"font-size:11px; color:#888; margin:8px 0 0;\">Preview real: página Elementor en Borrador dentro de WordPress (no es una imagen ni un render aparte).</p>\n      </div>\n\n      <!-- Panel lateral -->\n      <div style=\"width:220px; flex:0 0 220px; padding:0 32px 24px 20px; border-left:1.5px solid var(--bu-surface);\">\n        <button style=\"width:100%; text-align:left; padding:10px 12px; margin-bottom:8px; border:1.5px solid var(--bu-surface); border-radius:8px; background:#fff; font-size:13px; font-weight:600; cursor:pointer;\">✏️ Editar textos</button>\n        <button style=\"width:100%; text-align:left; padding:10px 12px; margin-bottom:8px; border:1.5px solid var(--bu-surface); border-radius:8px; background:#fff; font-size:13px; font-weight:600; cursor:pointer;\">🔄 Regenerar sección</button>\n        <button style=\"width:100%; text-align:left; padding:10px 12px; margin-bottom:20px; border:1.5px solid var(--bu-surface); border-radius:8px; background:#fff; font-size:13px; font-weight:600; cursor:pointer;\">🌓 Claro / oscuro</button>\n        <button onclick=\"uwGo(5)\" style=\"width:100%; background:var(--bu-accent); color:#fff; border:none; padding:14px 0; border-radius:30px; font-weight:700; font-size:14px; cursor:pointer;\">✅ Aceptar y enviar</button>\n      </div>\n    </div>\n  </section>\n\n  <!-- ===================== PANTALLA 5: Confirmación ===================== -->\n  <section id=\"uw-screen-5\" class=\"uw-screen\" style=\"display:none; padding:70px 32px; text-align:center;\">\n    <div style=\"width:64px; height:64px; border-radius:50%; background:var(--bu-accent); color:#fff; font-size:32px; display:flex; align-items:center; justify-content:center; margin:0 auto 20px;\">✓</div>\n    <h2 style=\"font-family:'Anton',sans-serif; color:var(--bu-secondary); font-size:24px; margin:0 0 10px;\">Preview enviado</h2>\n    <p style=\"color:#555; font-size:14px; max-width:420px; margin:0 auto 28px;\">Tu solicitud quedó registrada. El Supervisor la revisará y, una vez aprobada, un Dev la tomará para completar imágenes, SEO y publicarla.</p>\n    <button onclick=\"uwGo(1)\" style=\"background:var(--bu-secondary); color:#fff; border:none; padding:12px 24px; border-radius:30px; font-weight:700; font-size:14px; cursor:pointer;\">Empezar otra landing</button>\n  </section>\n  <!-- fin pantallas -->\n\n  <style>\n    @keyframes uwspin { to { transform: rotate(360deg); } }\n    #usil-wizard-mockup input, #usil-wizard-mockup select, #usil-wizard-mockup textarea { box-sizing:border-box; }\n    #usil-wizard-mockup button { transition: opacity .15s; }\n    #usil-wizard-mockup button:hover { opacity:0.85; }\n  </style>\n\n  <script>\n  (function(){\n    var TOTAL = 4;\n    var stepsEl, stepperEl;\n\n    function renderStepper(active){\n      var labels = ['Preguntas','Procesando','Resultado','Preview'];\n      stepperEl.innerHTML = labels.map(function(l, i){\n        var n = i+1;\n        var on = n === active;\n        var done = n < active;\n        var bg = on ? 'rgba(255,255,255,0.25)' : 'transparent';\n        var opacity = done ? '1' : (on ? '1' : '0.5');\n        return '<span style=\"padding:4px 10px; border-radius:14px; background:'+bg+'; opacity:'+opacity+';\">'+n+'. '+l+'</span>';\n      }).join('');\n    }\n\n    window.uwGo = function(n){\n      for (var i=1;i<=5;i++){\n        var el = document.getElementById('uw-screen-'+i);\n        if (el) el.style.display = (i===n) ? 'block' : 'none';\n      }\n      if (n>=1 && n<=4) renderStepper(n);\n      if (n===2) runThinking();\n      if (n===4) uwSetViewport('desktop');\n    };\n\n    function runThinking(){\n      var steps = [\n        'Leyendo el contenido…',\n        'Eligiendo la estructura (widget/variante)…',\n        'Aplicando el estilo de marca (design.md de la BU)…',\n        'Armando el boceto…'\n      ];\n      stepsEl.innerHTML = steps.map(function(s,i){\n        return '<p id=\"uw-step-'+i+'\" style=\"margin:0 0 14px; font-size:14px; color:#aaa; display:flex; align-items:center; gap:10px;\">'\n          + '<span style=\"width:18px; height:18px; border-radius:50%; border:2px solid #ddd; flex:0 0 auto;\"></span>' + s + '</p>';\n      }).join('');\n      var i = 0;\n      function tick(){\n        if (i>0){\n          var prev = document.getElementById('uw-step-'+(i-1));\n          if (prev){ prev.style.color = 'var(--bu-secondary)'; prev.querySelector('span').style.background='var(--bu-accent)'; prev.querySelector('span').style.borderColor='var(--bu-accent)'; }\n        }\n        if (i < steps.length){\n          var cur = document.getElementById('uw-step-'+i);\n          if (cur){ cur.style.color = 'var(--bu-primary)'; cur.style.fontWeight = '700'; }\n          i++;\n          setTimeout(tick, 650);\n        } else {\n          setTimeout(function(){ uwGo(3); }, 400);\n        }\n      }\n      tick();\n    }\n\n    window.uwSetViewport = function(mode){\n      var frame = document.getElementById('uw-preview-frame');\n      var wrap = document.getElementById('uw-frame-wrap');\n      var btnD = document.getElementById('uw-vp-desktop');\n      var btnM = document.getElementById('uw-vp-mobile');\n      if (mode === 'mobile'){\n        wrap.style.maxWidth = '390px';\n        wrap.style.margin = '0 auto';\n        frame.style.height = '760px';\n        btnM.style.background = 'var(--bu-primary)'; btnM.style.color = '#fff'; btnM.style.borderColor = 'var(--bu-primary)';\n        btnD.style.background = '#fff'; btnD.style.color = 'inherit'; btnD.style.borderColor = 'var(--bu-surface)';\n      } else {\n        wrap.style.maxWidth = 'none';\n        wrap.style.margin = '0';\n        frame.style.height = '760px';\n        btnD.style.background = 'var(--bu-primary)'; btnD.style.color = '#fff'; btnD.style.borderColor = 'var(--bu-primary)';\n        btnM.style.background = '#fff'; btnM.style.color = 'inherit'; btnM.style.borderColor = 'var(--bu-surface)';\n      }\n    };\n\n    document.addEventListener('DOMContentLoaded', function(){\n      stepsEl = document.getElementById('uw-steps');\n      stepperEl = document.getElementById('uw-stepper');\n      uwGo(1);\n    });\n    if (document.readyState !== 'loading') {\n      stepsEl = document.getElementById('uw-steps');\n      stepperEl = document.getElementById('uw-stepper');\n      uwGo(1);\n    }\n  })();\n  </script>\n</div>\n"},"elements":[],"widgetType":"html"}],"isInner":false}]
